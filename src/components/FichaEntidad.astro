---
import type { Entidad, TipoNodo } from "../lib/grafo";
import { rutaEntidad, rutaMateria, rutaRelato } from "../lib/rutas";

interface Props {
	entidad: Entidad;
	materiaSlug: string;
	nodos: Map<string, { nombre: string; kind: TipoNodo }>;
}
const { entidad, materiaSlug, nodos } = Astro.props;

function rutaNodo(id: string): string {
	return nodos.get(id)?.kind === "relato"
		? rutaRelato(materiaSlug, id)
		: rutaEntidad(materiaSlug, id);
}

const relatos = entidad.relaciones.filter((r) => r.tipo === "participa_en");
const relaciones = entidad.relaciones.filter((r) => r.tipo !== "participa_en");
---

<article>
  <h1>{entidad.nombre}</h1>
  <p class="tipo">{entidad.tipo}</p>
  <p>{entidad.resumen}</p>

  {
    entidad.etiquetas?.length ? (
      <ul class="etiquetas">
        {entidad.etiquetas.map((et) => (
          <li>{et}</li>
        ))}
      </ul>
    ) : null
  }

  {
    entidad.atributos ? (
      <dl>
        {Object.entries(entidad.atributos).map(([clave, valor]) => (
          <div>
            <dt>{clave}</dt>
            <dd>{String(valor)}</dd>
          </div>
        ))}
      </dl>
    ) : null
  }

  {
    relaciones.length > 0 && (
      <section>
        <h2>Relaciones</h2>
        <ul>
          {relaciones.map((r) => (
            <li>
              {r.tipo.replaceAll('_', ' ')}:{' '}
              <a href={rutaNodo(r.destino)}>{nodos.get(r.destino)?.nombre ?? r.destino}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatos.length > 0 && (
      <section>
        <h2>Relatos</h2>
        <ul>
          {relatos.map((r) => (
            <li>
              <a href={rutaNodo(r.destino)}>{nodos.get(r.destino)?.nombre ?? r.destino}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p><a href={rutaMateria(materiaSlug)}>&larr; volver</a></p>
</article>
