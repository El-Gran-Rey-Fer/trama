---
import { TIPOS_GENEALOGIA } from "../lib/arbol";
import type { Entidad, TipoNodo } from "../lib/grafo";
import { calcularAspectRatio, type RetratoResuelto } from "../lib/retrato";
import {
	rutaActivo,
	rutaArbol,
	rutaEntidad,
	rutaMateria,
	rutaRelato,
} from "../lib/rutas";
import E from "./E.astro";
import Fuente from "./Fuente.astro";

interface Props {
	entidad: Entidad;
	materiaSlug: string;
	nodos: Map<string, { nombre: string; kind: TipoNodo }>;
	retrato?: RetratoResuelto;
}
const { entidad, materiaSlug, nodos, retrato } = Astro.props;

function rutaNodo(id: string): string {
	return nodos.get(id)?.kind === "relato"
		? rutaRelato(materiaSlug, id)
		: rutaEntidad(materiaSlug, id);
}

const relatos = entidad.relaciones.filter((r) => r.tipo === "participa_en");
const relaciones = entidad.relaciones.filter((r) => r.tipo !== "participa_en");
const Prosa = entidad.prosa;

// Árbol genealógico (plan de imágenes y álbum, paso A7): solo se enlaza
// cuando la entidad tiene al menos una arista de parentesco.
const tieneGenealogia = entidad.relaciones.some((r) =>
	TIPOS_GENEALOGIA.includes(r.tipo),
);

// La propia obra muestra su imagen entera (sin foco: aquí no se recorta a
// una figura, se ve la pieza completa). Cualquier otra entidad muestra su
// retrato, recortado con el foco de la relación `representado_en`.
const imagen = entidad.imagen ?? retrato?.imagen;
const foco = entidad.imagen ? undefined : retrato?.foco;
const recorte = entidad.imagen ? undefined : retrato?.recorte;
// Sin recorte, la ficha usa su caja panorámica fija de siempre (retrocompatible).
// Con recorte, adapta su alto al aspect-ratio real (una estatua vertical
// necesita mucho más alto que ancho; ningún `foco` por sí solo lo resuelve).
const aspectRatio =
	foco && recorte && imagen ? calcularAspectRatio(imagen, recorte) : undefined;

const esStub =
	!imagen &&
	!Prosa &&
	!entidad.atributos &&
	relaciones.length === 0 &&
	relatos.length === 0;
---

<article class="ficha">
  <a class="volver" id="volver-ficha" href={rutaMateria(materiaSlug)}>&lsaquo; volver</a>

  {
    imagen && (
      <figure class={`imagen${aspectRatio ? " imagen--recorte" : ""}`}>
        <img
          src={rutaActivo(imagen.archivo)}
          alt={imagen.alt ?? entidad.nombre}
          style={[
            foco ? `object-position: ${foco[0]}% ${foco[1]}%` : "",
            aspectRatio ? `aspect-ratio: ${aspectRatio}` : "",
          ]
            .filter(Boolean)
            .join("; ") || undefined}
        />
        {
          (imagen.credito || imagen.origen) && (
            <figcaption>
              {imagen.origen ? (
                <a href={imagen.origen}>{imagen.credito || "Fuente"}</a>
              ) : (
                imagen.credito
              )}
            </figcaption>
          )
        }
      </figure>
    )
  }

  <div class="cuerpo">
    <p class="tipo">{entidad.tipo}</p>
    <h1 class="nombre">{entidad.nombre}</h1>

    {
      entidad.epitetos?.length ? (
        <ul class="chips">
          {entidad.epitetos.map((ep) => (
            <li>{ep}</li>
          ))}
        </ul>
      ) : null
    }

    {
      Prosa ? (
        <div class="prosa">
          <Prosa components={{ E, Fuente }} />
        </div>
      ) : (
        <p class="resumen">{entidad.resumen}</p>
      )
    }

    {esStub && <p class="nota-stub">Ficha mínima. Aún no hay más contenido para esta entidad.</p>}

    {
      entidad.atributos ? (
        <dl class="campos">
          {Object.entries(entidad.atributos).map(([clave, valor]) => (
            <div class="campo">
              <dt>{clave}</dt>
              <dd>{String(valor)}</dd>
            </div>
          ))}
        </dl>
      ) : null
    }

    {
      tieneGenealogia && (
        <p class="ver-arbol">
          <a href={rutaArbol(materiaSlug, entidad.id)}>Ver árbol genealógico &rsaquo;</a>
        </p>
      )
    }

    {
      relaciones.length > 0 && (
        <section>
          <h2 class="etiqueta-seccion">Relaciones</h2>
          <ul class="relaciones">
            {relaciones.map((r) => (
              <li>
                <span class="tipo-relacion">{r.tipo.replaceAll("_", " ")}</span>
                <a href={rutaNodo(r.destino)}>{nodos.get(r.destino)?.nombre ?? r.destino}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatos.length > 0 && (
        <section>
          <h2 class="etiqueta-seccion">Aparece en</h2>
          <ul class="chips">
            {relatos.map((r) => (
              <li>
                <a href={rutaNodo(r.destino)}>{nodos.get(r.destino)?.nombre ?? r.destino}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</article>

<style>
  .ficha {
    background: var(--color-fondo-pantalla);
    color: var(--color-texto);
    max-width: 640px;
    margin: 0 auto;
  }

  .volver {
    display: inline-block;
    padding: 14px 20px 0;
    color: var(--color-acento);
    font-weight: 700;
    text-decoration: none;
  }

  .imagen {
    margin: 14px 0 0;
  }

  .imagen img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .imagen--recorte img {
    height: auto;
  }

  .imagen figcaption {
    padding: 4px 20px 0;
    font-size: 11px;
    color: var(--color-texto-muted);
  }

  .imagen figcaption a {
    color: inherit;
  }

  .cuerpo {
    padding: 4px 20px 32px;
  }

  .tipo {
    margin: 14px 0 0;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nombre {
    margin: 4px 0 12px;
    font-size: 28px;
    font-weight: var(--peso-titulo);
    line-height: 1.1;
  }

  .resumen,
  .prosa :global(p) {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.6;
  }

  .nota-stub {
    margin: 0 0 14px;
    font-size: 13px;
    font-style: italic;
    color: var(--color-texto-muted);
  }

  .ver-arbol {
    margin: 0 0 14px;
  }

  .ver-arbol a {
    color: var(--color-acento);
    font-weight: 600;
    text-decoration: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  .chips li,
  .chips a {
    background: var(--color-chip-fondo);
    color: var(--color-chip-texto);
    border-radius: var(--radio);
    padding: 5px 10px;
    font-size: 13px;
    text-decoration: none;
  }

  .campos {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 18px;
    background: var(--color-tarjeta-fondo);
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    padding: 12px 14px;
  }

  .campo {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }

  .campo dt {
    color: var(--color-texto-muted);
    text-transform: capitalize;
  }

  .campo dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .etiqueta-seccion {
    margin: 18px 0 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .relaciones {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .relaciones li {
    display: flex;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    font-size: 14px;
  }

  .tipo-relacion {
    color: var(--color-texto-muted);
    min-width: 110px;
  }

  .relaciones a {
    color: var(--color-texto);
    font-weight: 600;
  }

  /* Escritorio (proyecto Trama de Claude Design): con retrato, la ficha
     pasa a imagen a la izquierda + texto a la derecha, en vez de imagen
     arriba y texto debajo. Sin retrato no hay nada que poner en la
     columna izquierda, así que se queda en una sola columna centrada. */
  @media (min-width: 860px) {
    .ficha:has(.imagen) {
      max-width: 900px;
      margin: 24px auto;
      padding: 0 32px;
      display: grid;
      grid-template-columns: 320px 1fr;
      align-items: start;
      gap: 32px;
    }

    .ficha:has(.imagen) .volver {
      grid-column: 1 / -1;
      padding: 0;
    }

    .ficha:has(.imagen) .imagen {
      margin: 0;
    }

    .ficha:has(.imagen) .imagen img {
      height: 100%;
      min-height: 360px;
      border-radius: var(--radio);
    }

    .ficha:has(.imagen) .cuerpo {
      padding: 0;
    }

    .ficha:has(.imagen) .tipo {
      margin-top: 0;
    }
  }
</style>

<script define:vars={{ materiaSlug }}>
  // Origen-aware sin mecanismo nuevo por página estática: cada ficha es su
  // propia URL, así que se resuelve con document.referrer en cliente en vez
  // de un query param. Sin JS o sin referrer, se queda el "‹ volver" a la
  // portada de la materia (SSR de arriba), que siempre es válido.
  const el = document.getElementById("volver-ficha");
  if (el instanceof HTMLAnchorElement && document.referrer) {
    try {
      const ref = new URL(document.referrer);
      if (ref.origin === location.origin) {
        if (ref.pathname.includes(`/${materiaSlug}/m/`)) {
          el.textContent = "‹ Relato";
          el.href = document.referrer;
        } else if (ref.pathname.endsWith(`/${materiaSlug}/`)) {
          el.textContent = "‹ Álbum";
          el.href = document.referrer;
        }
      }
    } catch {
      // document.referrer no siempre es una URL válida (p. ej. vacío en
      // navegación directa); el fallback SSR ya cubre ese caso.
    }
  }
</script>
