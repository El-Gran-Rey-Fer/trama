---
import { getCollection } from "astro:content";
import { capitulosQueDesbloquean, cargarCapitulos } from "../lib/capitulos";
import { construirGrafo, obtenerEntidad } from "../lib/grafo";
import { resolverRetrato } from "../lib/retrato";
import { rutaEntidad, rutaRelato } from "../lib/rutas";

interface Props {
	id: string;
}
const { id } = Astro.props;

// `<E />` se usa dentro de la prosa MDX de un relato, así que no recibe la
// materia como prop — se resuelve del slug de la ruta actual (bloque V):
// `Astro.params` está disponible en cualquier componente del árbol de una
// misma request/generación, no solo en la página que la declaró. El slug
// público de la ruta no es el materiaId que `construirGrafo` necesita (uno
// es cosmético, el otro es el nombre de la carpeta de contenido), así que se
// busca la entrada de `materias` cuyo `data.slug` coincida.
const materiaSlugRuta = Astro.params.materia;
const materiaEntry = materiaSlugRuta
	? (await getCollection("materias")).find(
			(m) => m.data.slug === materiaSlugRuta,
		)
	: undefined;
if (!materiaEntry) {
	throw new Error(
		`<E id="${id}" /> no puede resolver la materia de la ruta actual (${materiaSlugRuta})`,
	);
}

const grafo = await construirGrafo(materiaEntry.id);
const nodo = obtenerEntidad(grafo, id);
if (!nodo)
	throw new Error(`<E id="${id}" /> no encuentra esa entidad en el grafo`);

const href =
	nodo.kind === "relato"
		? rutaRelato(grafo.slug, id)
		: rutaEntidad(grafo.slug, id);

// Único por aparición (no por entidad): la misma entidad puede citarse varias
// veces en un relato, y cada botón necesita su propio popover en el DOM.
const popoverId = `mini-${crypto.randomUUID()}`;
const etiquetaVerMas =
	nodo.kind === "relato" ? "Leer relato →" : "Ver ficha completa →";

// Modo aventura, paso A2 (plan de imágenes y álbum): el contenido del popover
// ya NO se renderiza aquí. Un `<div popover>` es un elemento de bloque, y
// vivir anidado en el párrafo MDX que envuelve a `<E />` hacía que el
// navegador cerrara ese `<p>` en cuanto lo encontraba. Solo se emite el
// trigger (inline, válido dentro de un párrafo) y sus datos; el layout
// (`Base.astro`, vía `lib/minifichas.ts`) construye el popover una sola vez
// por página y lo cuelga fuera del flujo de la prosa.
const retrato = resolverRetrato(grafo, nodo);

// Modo aventura, bloque W: qué capítulos desbloquean el destino de este
// `<E />` — casi siempre uno. `minifichas.ts` decide con esto, en cliente, si
// el botón se atenúa (§2.1: "texto plano atenuado, con el nombre visible").
const capitulos = await cargarCapitulos(materiaEntry.id);
const desbloqueadoPor = capitulosQueDesbloquean(
	capitulos,
	id,
	nodo.kind === "relato" ? "relato" : "entidad",
);

const datosMiniFicha = {
	tipo: nodo.tipo,
	nombre: nodo.nombre,
	epitetos: nodo.epitetos ?? [],
	resumen: nodo.resumen,
	href,
	etiquetaVerMas,
	retrato: retrato
		? {
				archivo: retrato.imagen.archivo,
				alt: retrato.imagen.alt,
				foco: retrato.foco,
			}
		: null,
	desbloqueadoPor,
};
---

<button
  type="button"
  class="e-link"
  popovertarget={popoverId}
  data-entidad-id={id}
>
  <slot>{nodo.nombre}</slot>
</button>
<script
  is:inline
  type="application/json"
  data-mini-ficha={popoverId}
  set:html={JSON.stringify(datosMiniFicha)}
/>

<style>
  .e-link {
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--color-texto);
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-acento);
    text-underline-offset: 3px;
  }

  /* Modo aventura, bloque W (§2.1): destino sin desbloquear — texto plano
     atenuado, nombre visible, sin popover. `minifichas.ts` quita
     `popovertarget` y añade esta clase en cliente. */
  .e-link--atenuado {
    color: var(--color-texto-muted);
    cursor: default;
    text-decoration-color: var(--color-texto-muted);
    text-decoration-style: dotted;
  }
</style>
