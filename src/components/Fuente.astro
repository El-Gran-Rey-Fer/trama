---
import { getCollection } from "astro:content";

interface Props {
	id: string;
	obra?: boolean;
}
const { id, obra = false } = Astro.props;

// Mismo mecanismo que <E /> (bloque V): `<Fuente />` vive en la prosa MDX de
// un relato, sin prop de materia — se resuelve del slug de la ruta actual.
const materiaSlugRuta = Astro.params.materia;
const materiaEntry = materiaSlugRuta
	? (await getCollection("materias")).find(
			(m) => m.data.slug === materiaSlugRuta,
		)
	: undefined;
const fuente = materiaEntry?.data.fuentes?.[id];
---

{
	obra ? (
		<cite>{fuente?.autor ? `${fuente.autor}, ${fuente.obra}` : fuente?.obra}</cite>
	) : (
		<cite title={fuente?.obra}>{fuente?.autor ?? fuente?.obra}</cite>
	)
}
