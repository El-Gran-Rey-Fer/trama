---
import Muro from "../components/Muro.astro";
import ParticipantesRelato, {
	type Participante,
} from "../components/ParticipantesRelato.astro";
import type { CapituloResumen } from "../lib/estado";
import {
	rutaCapitulo,
	rutaEntidad,
	rutaExamen,
	rutaMateria,
} from "../lib/rutas";
import Base from "./Base.astro";

interface Props {
	id: string;
	titulo: string;
	resumen: string;
	materiaSlug: string;
	era?: string | null;
	participantes: Participante[];
	lugar: { id: string; nombre: string } | null;
	capituloId?: string;
	capituloNombre?: string;
	// Muro de aventura (bloque W): la cadena completa de capítulos activos y
	// el (como mucho uno) capítulo que desbloquea este relato.
	cadenaCapitulos: CapituloResumen[];
	capitulosQueDesbloquean: string[];
}
const {
	id,
	titulo,
	resumen,
	materiaSlug,
	era,
	participantes,
	lugar,
	capituloId,
	capituloNombre,
	cadenaCapitulos,
	capitulosQueDesbloquean,
} = Astro.props;

// Gating del CTA de examen (§4.4, extendido por consistencia a esta página):
// todos los relatos ESCRITOS del capítulo dueño, no solo este — antes solo
// reflejaba si este relato estaba leído, sin mirar el resto.
const relatosCapitulo =
	cadenaCapitulos.find((c) => c.id === capituloId)?.relatos ?? [];
---

<Base titulo={titulo} materiaSlug={materiaSlug}>
  <Muro
    cadena={cadenaCapitulos}
    capitulosQueDesbloquean={capitulosQueDesbloquean}
    materiaSlug={materiaSlug}
  >
  <article class="relato">
    {
      capituloId && (
        <p class="volver-capitulo-wrap">
          <a class="volver-capitulo" href={rutaCapitulo(materiaSlug, capituloId)}>
            &lsaquo; {capituloNombre}
          </a>
        </p>
      )
    }
    <header class="cabecera">
      {era && <p class="era">{era}</p>}
      <h1 class="titulo">{titulo}</h1>
      <p class="resumen">{resumen}</p>
    </header>

    <div class="cuerpo">
      <slot />
    </div>

    {
      lugar && (
        <p class="lugar">
          Lugar: <a href={rutaEntidad(materiaSlug, lugar.id)}>{lugar.nombre}</a>
        </p>
      )
    }

    <div class="leido-wrap">
      <button type="button" class="marcar-leido" data-relato-id={id}>
        Marcar relato como leído
      </button>
      {
        capituloId && (
          <>
            <a
              class="examen-cta"
              id="examen-cta"
              href={rutaExamen(materiaSlug, capituloId)}
              aria-disabled="true"
              tabindex="-1"
            >
              Examen de este capítulo
            </a>
            <ul id="pendientes-examen-cta" class="pendientes-examen-cta" />
          </>
        )
      }
    </div>

    {
      participantes.length > 0 && (
        <section class="participantes">
          <h2 class="etiqueta-seccion">Participantes</h2>
          <ParticipantesRelato participantes={participantes} materiaSlug={materiaSlug} />
        </section>
      )
    }

    <p class="volver-wrap"><a class="volver" href={rutaMateria(materiaSlug)}>&lsaquo; volver</a></p>
  </article>
  </Muro>
</Base>

<style>
  .relato {
    max-width: 640px;
    margin: 0 auto;
  }

  .volver-capitulo-wrap {
    margin: 0;
    padding: 16px 20px 0;
  }

  .volver-capitulo {
    color: var(--color-texto-muted);
    font-family: var(--fuente-titulo);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .cabecera {
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
  }

  .era {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-acento);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .titulo {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: var(--peso-titulo);
    line-height: 1.1;
  }

  .resumen {
    margin: 0;
    font-size: 15px;
    color: var(--color-texto-muted);
    line-height: 1.5;
  }

  .cuerpo {
    padding: 20px;
    color: var(--color-texto);
  }

  .cuerpo :global(p) {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.65;
  }

  .lugar,
  .participantes {
    padding: 0 20px;
  }

  .etiqueta-seccion {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .leido-wrap {
    padding: 12px 20px 0;
  }

  .marcar-leido {
    display: block;
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: var(--radio);
    background: var(--color-acento);
    color: var(--color-acento-contraste);
    font-size: 16px;
    font-weight: 700;
    font-family: var(--fuente);
    cursor: pointer;
  }

  .marcar-leido.leido {
    background: var(--color-tarjeta-fondo);
    color: var(--color-texto-muted);
  }

  .examen-cta {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: none;
    color: var(--color-acento);
    font-size: 16px;
    font-weight: 700;
    font-family: var(--fuente-titulo);
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
  }

  .examen-cta[aria-disabled="true"] {
    color: var(--color-texto-muted);
    cursor: not-allowed;
  }

  .pendientes-examen-cta {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .pendientes-examen-cta li {
    padding: 4px 0;
  }

  .pendientes-examen-cta a {
    color: var(--color-acento);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .volver-wrap {
    padding: 20px;
  }

  .volver {
    color: var(--color-acento);
    font-weight: 700;
    text-decoration: none;
  }
</style>

{
  capituloId && (
    <script
      is:inline
      type="application/json"
      id="datos-examen-cta"
      set:html={JSON.stringify(relatosCapitulo)}
    />
  )
}

<script>
  import { leerEstado, guardarEstado } from "../lib/estado";
  import { rutaRelato } from "../lib/rutas";

  interface RelatoDatos {
    id: string;
    nombre: string;
  }

  const boton = document.querySelector<HTMLButtonElement>(".marcar-leido");
  if (boton) {
    const relatoId = boton.dataset.relatoId ?? "";

    const aplicar = (leido: boolean) => {
      boton.textContent = leido ? "✓ Marcado como leído" : "Marcar relato como leído";
      boton.classList.toggle("leido", leido);
    };

    aplicar(leerEstado().leidos.includes(relatoId));

    boton.addEventListener("click", () => {
      const estado = leerEstado();
      if (!estado.leidos.includes(relatoId)) {
        estado.leidos.push(relatoId);
        guardarEstado(estado);
      }
      aplicar(true);
      actualizarExamenCta();
    });
  }

  // Gating del CTA de examen (§4.4, extendido a esta página por consistencia
  // con c/[id].astro): visible siempre, deshabilitado hasta que TODOS los
  // relatos escritos del capítulo dueño —no solo este— estén en `leidos`.
  const materiaSlug = document.documentElement.dataset.materia ?? "";
  const examenCta = document.getElementById("examen-cta");
  const listaPendientes = document.getElementById("pendientes-examen-cta");
  const datosEl = document.getElementById("datos-examen-cta");
  const relatosCapitulo: RelatoDatos[] = datosEl
    ? JSON.parse(datosEl.textContent ?? "[]")
    : [];

  function actualizarExamenCta() {
    if (!examenCta || !listaPendientes) return;
    const estado = leerEstado();
    const pendientes = relatosCapitulo.filter((r) => !estado.leidos.includes(r.id));
    listaPendientes.innerHTML = "";
    if (pendientes.length === 0) {
      examenCta.removeAttribute("aria-disabled");
      examenCta.removeAttribute("tabindex");
      return;
    }
    examenCta.setAttribute("aria-disabled", "true");
    examenCta.setAttribute("tabindex", "-1");
    for (const relato of pendientes) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = rutaRelato(materiaSlug, relato.id);
      a.textContent = relato.nombre;
      li.appendChild(a);
      listaPendientes.appendChild(li);
    }
  }

  examenCta?.addEventListener("click", (evento) => {
    if (examenCta.getAttribute("aria-disabled") === "true") evento.preventDefault();
  });

  actualizarExamenCta();
</script>
