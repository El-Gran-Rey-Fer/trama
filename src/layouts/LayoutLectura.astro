---
import { rutaMateria } from "../lib/rutas";
import Base from "./Base.astro";

interface Props {
	titulo: string;
	resumen: string;
	materiaSlug: string;
}
const { titulo, resumen, materiaSlug } = Astro.props;
---

<Base titulo={titulo}>
  <article>
    <h1>{titulo}</h1>
    <p class="resumen">{resumen}</p>
    <slot />
    <p><a href={rutaMateria(materiaSlug)}>&larr; volver</a></p>
  </article>
</Base>
