---
import "../styles/tokens.css";
import {
	rutaAjustes,
	rutaGrafo,
	rutaJugarMenu,
	rutaMateria,
} from "../lib/rutas";

interface Props {
	titulo: string;
	// Sin materiaSlug (p. ej. portada de trama, selector de materias) no hay
	// tab bar: no hay "Leer/Álbum/Practicar/Ajustes" de qué materia.
	materiaSlug?: string;
}
const { titulo, materiaSlug } = Astro.props;

const pestanas = materiaSlug
	? [
			{
				id: "leer",
				etiqueta: "Leer",
				icono: "📖",
				href: `${rutaMateria(materiaSlug)}#capitulos`,
			},
			{
				id: "album",
				etiqueta: "Álbum",
				icono: "🗂",
				href: `${rutaMateria(materiaSlug)}#album`,
			},
			{
				id: "arbol",
				etiqueta: "Árbol",
				icono: "🌳",
				href: rutaGrafo(materiaSlug),
			},
			{
				id: "practicar",
				etiqueta: "Practicar",
				icono: "✎",
				href: rutaJugarMenu(materiaSlug),
			},
			{
				id: "ajustes",
				etiqueta: "Ajustes",
				icono: "⚙",
				href: rutaAjustes(materiaSlug),
			},
		]
	: [];

// Activa por prefijo de ruta — suficiente para practicar/ajustes, que tienen
// URL propia. Leer y Álbum comparten página (dos anclas de la misma
// portada de materia) y no se distinguen aquí; no marcar ninguna es mejor
// que marcar la incorrecta.
const rutaActual = Astro.url.pathname;
function activa(id: string, href: string): boolean {
	if (id === "leer" || id === "album") return false;
	return rutaActual.startsWith(href.split("#")[0]);
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Oswald:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ "con-tabs": pestanas.length > 0 }}>
    <header class="cabecera-global">
      <button type="button" id="interruptor-modo" class="interruptor-modo">
        Modo: <span class="valor-modo">aventura</span>
      </button>
    </header>
    <slot />
    <div id="minifichas"></div>
    {
      pestanas.length > 0 && (
        <nav class="tabs" aria-label="Navegación principal">
          {pestanas.map((p) => (
            <a href={p.href} aria-current={activa(p.id, p.href) ? "page" : undefined}>
              <span aria-hidden="true">{p.icono}</span>
              <span>{p.etiqueta}</span>
            </a>
          ))}
        </nav>
      )
    }
  </body>
</html>

<style>
  .cabecera-global {
    display: flex;
    justify-content: flex-end;
    padding: 8px 12px;
  }

  .interruptor-modo {
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: var(--color-tarjeta-fondo);
    color: var(--color-texto);
    font-family: var(--fuente);
    font-size: 13px;
    padding: 6px 10px;
    cursor: pointer;
  }

  .valor-modo {
    font-weight: 700;
    text-transform: capitalize;
  }

  .tabs {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    border-top: 1px solid var(--color-tarjeta-borde);
    background: var(--color-fondo-pantalla);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .tabs a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 0 6px;
    color: var(--color-texto-muted);
    text-decoration: none;
    font-family: var(--fuente-titulo);
    font-size: 11px;
    font-weight: 600;
  }

  .tabs a span[aria-hidden] {
    font-size: 18px;
    line-height: 1;
    filter: grayscale(1) opacity(0.7);
  }

  .tabs a[aria-current="page"] {
    color: var(--color-acento);
    font-weight: 700;
  }

  .tabs a[aria-current="page"] span[aria-hidden] {
    filter: none;
  }
</style>

<script>
  import { montarMinifichas } from "../lib/minifichas";

  const contenedorMinifichas = document.getElementById("minifichas");
  if (contenedorMinifichas) montarMinifichas(contenedorMinifichas);
</script>

<script>
  import { leerEstado, guardarEstado } from "../lib/estado";

  const boton = document.getElementById("interruptor-modo");
  const valor = boton?.querySelector<HTMLElement>(".valor-modo");

  function pintar(modo: "aventura" | "sandbox") {
    if (valor) valor.textContent = modo;
    boton?.setAttribute("aria-pressed", String(modo === "sandbox"));
  }

  pintar(leerEstado().modo);

  boton?.addEventListener("click", () => {
    const estado = leerEstado();
    estado.modo = estado.modo === "aventura" ? "sandbox" : "aventura";
    guardarEstado(estado);
    pintar(estado.modo);
    // Recarga para que la página actual recalcule su vista con el modo
    // nuevo (portada, práctica). Si se nota lento, se sustituye por un
    // evento que cada página escuche en vez de recargar entera.
    location.reload();
  });
</script>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-fondo-pagina);
    color: var(--color-texto);
    font-family: var(--fuente);
  }

  /* Deja sitio a la tab bar fija para que no tape el final del contenido. */
  body.con-tabs {
    padding-bottom: 56px;
  }

  :focus-visible {
    outline: 2px solid var(--color-acento);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }

  /* Minificha de <E />: construida por lib/minifichas.ts fuera del flujo de
     la prosa (ver E.astro), así que estos estilos no pueden ser un <style>
     con scope de componente — la etiqueta que aplica scope no llega a un
     elemento creado por JS en tiempo de ejecución. */
  .mini-ficha {
    position: fixed;
    left: 50%;
    bottom: 0;
    top: auto;
    transform: translateX(-50%);
    width: 100%;
    max-width: 640px;
    margin: 0;
    border: none;
    border-top: 1px solid var(--color-tarjeta-borde);
    border-radius: 16px 16px 0 0;
    background: var(--color-fondo-pantalla);
    color: var(--color-texto);
    padding: 10px 20px 24px;
    box-shadow: 0 -8px 24px oklch(0% 0 0 / 0.18);
  }

  .mini-ficha::backdrop {
    background: oklch(0% 0 0 / 0.35);
  }

  .tirador {
    width: 36px;
    height: 4px;
    border-radius: 99px;
    background: var(--color-tarjeta-borde);
    margin: 0 auto 14px;
  }

  .mini-cabecera {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .mini-cabecera .casilla {
    width: 56px;
    flex: 0 0 auto;
  }

  .mini-tipo {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mini-nombre {
    margin: 4px 0 10px;
    font-size: 22px;
    font-weight: var(--peso-titulo);
  }

  .mini-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .mini-chips li {
    background: var(--color-chip-fondo);
    color: var(--color-chip-texto);
    border-radius: var(--radio);
    padding: 5px 10px;
    font-size: 13px;
  }

  .mini-resumen {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.55;
  }

  .mini-acciones {
    display: flex;
    gap: 10px;
  }

  .mini-cerrar {
    flex: 0 0 auto;
    padding: 12px 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: none;
    color: var(--color-texto-muted);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .mini-ver {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    border: none;
    border-radius: var(--radio);
    background: var(--color-acento);
    color: var(--color-acento-contraste);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }

  /* Casilla (plan de imágenes y álbum §3.3): retrato o inicial sobre el
     color del tipo. Global, no con scope de componente, porque la misma
     marca la construye Casilla.astro (servidor) y lib/minifichas.ts
     (cliente, dentro de la minificha de <E />) — un solo lenguaje visual
     para los dos casos. */
  .casilla {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--color-tarjeta-fondo);
  }

  .casilla-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .casilla-inicial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.6em;
  }

  .casilla[data-estado="sin-encontrar"] {
    filter: grayscale(1);
    opacity: 0.45;
  }

  /* "Dominado" (examen de personaje superado, plan de imágenes y álbum,
     carril C): borde de acento + marca en la esquina. Sin icono nuevo por
     tipo — decisión explícita: la inicial-sobre-color no cambia. */
  .casilla[data-estado="dominado"] {
    outline: 2px solid var(--color-acento);
    outline-offset: -2px;
  }

  .casilla[data-estado="dominado"]::after {
    content: "✓";
    position: absolute;
    bottom: 2px;
    right: 3px;
    color: var(--color-acento-contraste);
    background: var(--color-acento);
    font-size: 0.6em;
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;
    padding: 2px 3px;
  }
</style>
