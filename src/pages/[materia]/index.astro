---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { rutaEntidad, rutaPracticar } from "../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({ params: { materia: m.data.slug } }));
}

const { materia } = Astro.params;
const entidades = await getCollection("entidades");
---

<Base titulo={`Entidades — ${materia}`}>
  <h1>{materia}</h1>
  <p><a href={rutaPracticar(materia)}>Practicar</a></p>
  <ul>
    {
      entidades.map((e) => (
        <li>
          <a href={rutaEntidad(materia, e.id)}>{e.data.nombre}</a>
        </li>
      ))
    }
  </ul>
</Base>
