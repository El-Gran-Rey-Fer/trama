---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { cargarCapitulos } from "../../lib/capitulos";
import { rutaCapitulo, rutaReto } from "../../lib/rutas";
import { generarTarjetas } from "../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({
		params: { materia: m.data.slug },
		props: { materiaId: m.id },
	}));
}

const { materia } = Astro.params;
const { materiaId } = Astro.props;
const materiaEntry = await getEntry("materias", materiaId);
const eras = materiaEntry?.data.eras ?? [];
const capitulos = await cargarCapitulos(materiaId);
const activos = capitulos.filter((c) => c.activo);
// era.posición sobre todos los capítulos, activos o no: la numeración ya
// refleja su lugar real en el mapa desde el primer día, y activar uno no
// corre la de los demás — el hueco ya estaba contado.
const numeroPorCapitulo = new Map<string, string>();
eras.forEach((era, indiceEra) => {
	const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
	capitulosDeEra.forEach((c, indiceCapitulo) => {
		numeroPorCapitulo.set(c.id, `${indiceEra + 1}.${indiceCapitulo + 1}`);
	});
});
// El recuento de contenido (sandbox, plan de gamificación §5) se calcula aquí
// —en build, no en cliente— y viaja en el mismo JSON que ya usaba el
// vocabulario de aventura: mismo patrón que examen.astro:37 con
// `generarTarjetas`. `numero` (era.posición) viaja también, para el módulo
// de continuación (§6) — sin recalcularlo en cliente.
const datosCapitulos = await Promise.all(
	activos.map(async (c) => ({
		id: c.id,
		nombre: c.nombre,
		numero: numeroPorCapitulo.get(c.id) ?? "",
		era: c.era,
		relatos: c.relatosResumen,
		recuento: {
			relatos: c.relatosEscritos.length,
			entidades: c.conjunto.size,
			tarjetas: (await generarTarjetas(materiaId, c.conjunto)).length,
		},
	})),
);

function pluralizarBuild(
	cantidad: number,
	singular: string,
	plural: string,
): string {
	return `${cantidad} ${cantidad === 1 ? singular : plural}`;
}

const nombreMateria = materiaEntry?.data.nombre ?? materia;
---

<Base titulo={`${nombreMateria} — modo aventura`} materiaSlug={materia}>
  <section id="continua" class="seccion-continua" hidden>
    <p class="continua-etiqueta">Continúa</p>
    <a id="continua-enlace" class="continua-fila" href="#">
      <span class="continua-texto">
        <span id="continua-numero" class="continua-numero"></span>
        <span id="continua-nombre" class="continua-nombre"></span>
        <span id="continua-detalle" class="continua-detalle"></span>
      </span>
      <span class="continua-boton">Seguir &rarr;</span>
    </a>
  </section>

  <!--
    Reto del día (bloque Z, §9): módulo secundario, siempre por debajo del de
    continuación — nunca lo primero, para que no parezca la vía principal.
    Visible en los dos modos: no depende de la progresión de aventura, solo
    la respeta cuando la hay.
  -->
  <section class="seccion-reto">
    <a class="reto-fila" href={rutaReto(materia)}>
      <span class="reto-texto">
        <span class="reto-etiqueta">Reto del día</span>
        <span id="reto-detalle" class="reto-detalle">Cinco preguntas rápidas con lo que ya tienes.</span>
      </span>
      <span class="reto-boton">Jugar &rarr;</span>
    </a>
  </section>

  <section id="capitulos" class="seccion-leer">
    <div class="cabecera-lista">
      <h1 class="titulo-lista">{nombreMateria}</h1>
    </div>

    <div class="mapa-materia">
      <!--
        Maestro-detalle (propuesta de Design, plan de gamificación §11): en
        escritorio, columna de eras a la izquierda + panel de la era activa a
        la derecha. En móvil, el propio encabezado de cada panel hace de
        acordeón — mismo botón, mismo `mostrarEra`, el CSS decide qué se ve.
        Las 5 eras y sus capítulos están siempre en el DOM (solo `hidden`):
        ningún enlace deja de existir por no ser la era seleccionada.
      -->
      <nav class="rail-eras" aria-label="Eras">
        {
          eras.map((era) => {
            const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
            return (
              <button type="button" class="boton-era" data-era-boton={era.id}>
                <span class="era-punto" aria-hidden="true" />
                <span class="era-texto">
                  <span class="era-nombre">{era.nombre}</span>
                  {capitulosDeEra.length > 0 && (
                    <span class="era-fraccion" data-era-fraccion={era.id}>
                      {pluralizarBuild(capitulosDeEra.length, "capítulo", "capítulos")}
                    </span>
                  )}
                </span>
              </button>
            );
          })
        }
      </nav>

      {
        eras.map((era) => {
          const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
          return (
            <div class="panel-era" data-era-panel={era.id} hidden>
              <button type="button" class="panel-era-cabecera" data-era-boton={era.id}>
                <span class="etiqueta-era">{era.nombre}</span>
                {capitulosDeEra.length > 0 && (
                  <span class="era-fraccion" data-era-fraccion={era.id}>
                    {pluralizarBuild(capitulosDeEra.length, "capítulo", "capítulos")}
                  </span>
                )}
              </button>
              {capitulosDeEra.length === 0 ? (
                <p class="sin-capitulos">Sin capítulos todavía.</p>
              ) : (
                <ol class="lista-capitulos">
                  {capitulosDeEra.map((c) =>
                    c.activo ? (
                      <li data-capitulo={c.id} class="fila-capitulo">
                        <a href={rutaCapitulo(materia, c.id)} class="enlace-capitulo">
                          <span class="num-capitulo" aria-hidden="true">
                            {numeroPorCapitulo.get(c.id)}
                          </span>
                          <span class="texto-capitulo">
                            <span class="titulo-capitulo">{c.nombre}</span>
                            <span class="estado">Bloqueado</span>
                          </span>
                          <span class="chevron-texto" />
                          <span class="chevron-capitulo" aria-hidden="true">
                            ›
                          </span>
                        </a>
                      </li>
                    ) : (
                      <li class="fila-prevista">
                        <span class="num-capitulo num-capitulo-previsto" aria-hidden="true">
                          {numeroPorCapitulo.get(c.id)}
                        </span>
                        <span class="texto-capitulo">
                          <span class="titulo-capitulo">{c.nombre}</span>
                          <span class="estado">Próximamente</span>
                        </span>
                      </li>
                    ),
                  )}
                </ol>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <div
    id="muro-modal"
    class="muro-modal"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="muro-modal-mensaje"
  >
    <div class="muro-modal-fondo" data-cerrar-modal />
    <div class="muro-modal-panel">
      <p class="muro-modal-mensaje" id="muro-modal-mensaje" />
      <a class="muro-modal-boton" id="muro-modal-boton" href="#">
        Seguir &rarr;
      </a>
      <button type="button" class="muro-modal-sandbox" id="muro-modal-sandbox">
        Verlo en sandbox
      </button>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    id="datos-capitulos"
    set:html={JSON.stringify(datosCapitulos)}
  />

  <script>
    import {
      calcularEstadosCapitulos,
      leerEstado,
      type CapituloResumen,
      type EstadoVisualCapitulo,
    } from "../../lib/estado";
    import { calcularPasoAccionable, verEnSandboxYRecargar } from "../../lib/muroCliente";

    interface RecuentoCapitulo {
      relatos: number;
      entidades: number;
      tarjetas: number;
    }
    interface DatosCapitulo extends CapituloResumen {
      numero: string;
      era: string;
      recuento: RecuentoCapitulo;
    }

    function pluralizar(cantidad: number, singular: string, plural: string): string {
      return `${cantidad} ${cantidad === 1 ? singular : plural}`;
    }

    // Sandbox no tiene progresión (plan de gamificación §5): donde aventura
    // muestra estado, sandbox muestra peso de contenido — es lo que un lector
    // de enciclopedia quiere antes de entrar.
    function textoRecuento(r: RecuentoCapitulo): string {
      return [
        pluralizar(r.relatos, "relato", "relatos"),
        pluralizar(r.entidades, "entidad", "entidades"),
        pluralizar(r.tarjetas, "tarjeta", "tarjetas"),
      ].join(" · ");
    }

    // "En curso" cubre dos valores reales del enum ("abierto" = nada leído,
    // "en-curso" = algo leído) — el plan de gamificación §3 los funde en una
    // sola palabra y con eso pierde la distinción. En vez de una tercera
    // palabra (reabriría la colisión de "cerrado" que el bloque V ya cerró),
    // la fracción de relatos leídos hace el trabajo: mismo enum, mismo texto
    // base, número distinto.
    function etiquetaCapitulo(
      c: DatosCapitulo,
      estadoVisual: EstadoVisualCapitulo,
      estado: ReturnType<typeof leerEstado>,
    ): string {
      if (estadoVisual === "bloqueado") return "Bloqueado";
      if (estadoVisual === "superado") return "Superado";
      const total = c.relatos.length;
      const leidos = c.relatos.filter((r) => estado.leidos.includes(r.id)).length;
      return `En curso · ${leidos}/${total} ${total === 1 ? "relato" : "relatos"}`;
    }

    const datosCapitulosEl = document.getElementById("datos-capitulos");
    const datosCapitulos: DatosCapitulo[] = datosCapitulosEl
      ? JSON.parse(datosCapitulosEl.textContent ?? "[]")
      : [];
    const estado = leerEstado();
    const materiaSlug = document.documentElement.dataset.materia ?? "";

    const hoy = new Date().toISOString().slice(0, 10);
    const elRetoDetalle = document.getElementById("reto-detalle");
    if (elRetoDetalle) {
      elRetoDetalle.textContent =
        estado.retos.ultimaFecha === hoy
          ? `Ya lo hiciste hoy (${estado.retos.completados} en total) — repítelo si quieres.`
          : `Cinco preguntas rápidas con lo que ya tienes. Llevas ${estado.retos.completados}.`;
    }

    // Mapa de eras (propuesta de Design, plan de gamificación §11):
    // maestro-detalle en escritorio (rail + panel), acordeón en móvil (el
    // encabezado del panel es el mismo botón que el de la rail) — un único
    // `mostrarEra` para las dos formas, el CSS decide cuál se ve.
    function mostrarEra(id: string): void {
      for (const panel of document.querySelectorAll<HTMLElement>("[data-era-panel]")) {
        panel.hidden = panel.dataset.eraPanel !== id;
      }
      for (const boton of document.querySelectorAll<HTMLElement>("[data-era-boton]")) {
        boton.classList.toggle("activa", boton.dataset.eraBoton === id);
      }
    }
    for (const boton of document.querySelectorAll<HTMLElement>("[data-era-boton]")) {
      boton.addEventListener("click", () => {
        if (boton.dataset.eraBoton) mostrarEra(boton.dataset.eraBoton);
      });
    }

    const idsEraEnOrden = [
      ...document.querySelectorAll<HTMLElement>("[data-era-panel]"),
    ].map((p) => p.dataset.eraPanel ?? "");

    // Muro instantáneo (propuesta de Design): al clicar una tarjeta
    // bloqueada, en vez de navegar y toparse con el aviso de página completa
    // de Muro.astro, se muestra el mismo mensaje al momento. El aviso real
    // de Muro.astro sigue siendo el camino de verdad para URL directa o JS
    // desactivado — esto es solo un atajo, reutiliza `calcularPasoAccionable`
    // tal cual (§4.3: el mensaje siempre habla del capítulo activo, nunca del
    // que se clicó).
    function mensajeMuro(paso: ReturnType<typeof calcularPasoAccionable>): string {
      if (!paso) return "Este contenido todavía no está a tu alcance en el modo aventura.";
      return `Sigues en ${paso.capituloNombre}. ${paso.detalle.charAt(0).toUpperCase()}${paso.detalle.slice(1)}.`;
    }

    function abrirModalMuro(paso: ReturnType<typeof calcularPasoAccionable>): void {
      const modal = document.getElementById("muro-modal");
      const boton = document.getElementById("muro-modal-boton");
      document.getElementById("muro-modal-mensaje")!.textContent = mensajeMuro(paso);
      if (boton instanceof HTMLAnchorElement) {
        if (paso) {
          boton.href = paso.hrefAccion;
          boton.hidden = false;
        } else {
          boton.hidden = true;
        }
      }
      modal?.removeAttribute("hidden");
    }
    function cerrarModalMuro(): void {
      document.getElementById("muro-modal")?.setAttribute("hidden", "");
    }
    document.querySelector("[data-cerrar-modal]")?.addEventListener("click", cerrarModalMuro);
    document.getElementById("muro-modal-sandbox")?.addEventListener("click", verEnSandboxYRecargar);
    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape") cerrarModalMuro();
    });

    if (estado.modo === "sandbox") {
      for (const c of datosCapitulos) {
        const fila = document.querySelector(`[data-capitulo="${c.id}"]`);
        const el = fila?.querySelector(".estado");
        if (el) el.textContent = textoRecuento(c.recuento);
        const chevronTexto = fila?.querySelector(".chevron-texto");
        if (chevronTexto) chevronTexto.textContent = "Practicar ";
      }
      mostrarEra(idsEraEnOrden.find((id) => datosCapitulos.some((c) => c.era === id)) ?? idsEraEnOrden[0]);
    } else {
      const estadosCapitulos = calcularEstadosCapitulos(datosCapitulos, estado);
      for (const c of datosCapitulos) {
        const estadoCapitulo = estadosCapitulos[c.id];
        const fila = document.querySelector(`[data-capitulo="${c.id}"]`);
        const el = fila?.querySelector(".estado");
        if (el) el.textContent = etiquetaCapitulo(c, estadoCapitulo, estado);
        if (fila instanceof HTMLElement) {
          fila.dataset.estadoCapitulo = estadoCapitulo;
        }
        const numEl = fila?.querySelector(".num-capitulo");
        if (numEl instanceof HTMLElement) {
          if (estadoCapitulo === "superado") numEl.setAttribute("data-superado", "");
          else numEl.removeAttribute("data-superado");
        }
        if (estadoCapitulo === "bloqueado") {
          const enlace = fila?.querySelector<HTMLAnchorElement>(".enlace-capitulo");
          enlace?.addEventListener("click", (evento) => {
            evento.preventDefault();
            abrirModalMuro(calcularPasoAccionable(datosCapitulos, estado, materiaSlug));
          });
        }
      }

      // Fracción por era, excluyendo "Próximamente" del denominador — esos
      // capítulos no cuentan en la cadena de desbloqueo (§3 del plan), así
      // que tampoco cuentan aquí.
      for (const eraId of idsEraEnOrden) {
        const capsEra = datosCapitulos.filter((c) => c.era === eraId);
        if (capsEra.length === 0) continue;
        const superados = capsEra.filter((c) => estadosCapitulos[c.id] === "superado").length;
        for (const el of document.querySelectorAll(`[data-era-fraccion="${eraId}"]`)) {
          el.textContent = `${superados}/${capsEra.length}`;
        }
      }

      // Módulo de continuación (§6): solo en aventura, y solo si queda algún
      // paso pendiente — reutiliza el mismo cálculo que el muro (§4.3), cero
      // lógica duplicada.
      const paso = calcularPasoAccionable(datosCapitulos, estado, materiaSlug);
      if (paso) {
        const numero = datosCapitulos.find((c) => c.id === paso.capituloId)?.numero ?? "";
        document.getElementById("continua-numero")!.textContent = numero ? `${numero} · ` : "";
        document.getElementById("continua-nombre")!.textContent = paso.capituloNombre;
        document.getElementById("continua-detalle")!.textContent = ` — ${paso.detalle}`;
        const enlace = document.getElementById("continua-enlace");
        if (enlace instanceof HTMLAnchorElement) enlace.href = paso.hrefAccion;
        document.getElementById("continua")?.removeAttribute("hidden");
      }

      // Era por defecto abierta: la del capítulo activo (abierto/en-curso);
      // si no hay ninguno (todo superado, o nada empezado sin capítulo
      // activo posible), la primera era con algún capítulo activo.
      const activoId = Object.entries(estadosCapitulos).find(
        ([, v]) => v === "abierto" || v === "en-curso",
      )?.[0];
      const eraActivo = activoId ? datosCapitulos.find((c) => c.id === activoId)?.era : undefined;
      mostrarEra(
        eraActivo ??
          idsEraEnOrden.find((id) => datosCapitulos.some((c) => c.era === id)) ??
          idsEraEnOrden[0],
      );
    }
  </script>
</Base>

<style>
  .seccion-continua {
    margin: 16px 20px 0;
  }

  .continua-etiqueta {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .continua-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: var(--color-tarjeta-fondo);
    color: var(--color-texto);
    text-decoration: none;
  }

  .continua-texto {
    display: block;
    font-size: 15px;
  }

  .continua-numero,
  .continua-nombre {
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .continua-detalle {
    color: var(--color-texto-muted);
  }

  .continua-boton {
    flex: 0 0 auto;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 14px;
  }

  .seccion-reto {
    margin: 10px 20px 0;
  }

  .reto-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: none;
    color: var(--color-texto);
    text-decoration: none;
  }

  .reto-texto {
    display: block;
    font-size: 13px;
  }

  .reto-etiqueta {
    display: block;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .reto-detalle {
    color: var(--color-texto-muted);
  }

  .reto-boton {
    flex: 0 0 auto;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 13px;
  }

  .cabecera-lista {
    padding: 20px 20px 4px;
  }

  .titulo-lista {
    margin: 0;
    font-size: 26px;
    font-weight: var(--peso-titulo-grande);
    font-family: var(--fuente-titulo);
    text-transform: capitalize;
  }

  /*
   * Maestro-detalle (propuesta de Design, plan de gamificación §11): en
   * escritorio, `.rail-eras` (columna de botones) + `.panel-era` (el
   * seleccionado, visible) usan flexbox lado a lado. En móvil, `.rail-eras`
   * se oculta y el propio `.panel-era-cabecera` de cada panel hace de
   * acordeón — un solo `mostrarEra` en el script sirve para las dos formas.
   */
  .rail-eras {
    display: none;
  }

  .panel-era-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    margin: 18px 0 8px;
    padding: 10px 20px;
    border: none;
    background: none;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .etiqueta-era {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-acento);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--fuente-titulo);
  }

  .era-fraccion {
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .sin-capitulos {
    margin: 0 20px 12px;
    font-size: 13px;
    color: var(--color-texto-muted);
  }

  .lista-capitulos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fila-capitulo[data-estado-capitulo="bloqueado"] {
    opacity: 0.6;
  }

  .enlace-capitulo {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    color: var(--color-texto);
    text-decoration: none;
    box-sizing: border-box;
  }

  .num-capitulo {
    position: relative;
    flex: 0 0 auto;
    min-width: 28px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
  }

  /* Insignia de "superado" (mismo lenguaje que .casilla[data-estado="dominado"]
     de Base.astro: marca de acento en la esquina, no un icono nuevo). */
  .num-capitulo[data-superado]::after {
    content: "✓";
    position: absolute;
    top: -6px;
    right: -8px;
    color: var(--color-acento-contraste);
    background: var(--color-acento);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;
    padding: 2px 4px;
  }

  .texto-capitulo {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .titulo-capitulo {
    font-size: 17px;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .estado {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .chevron-texto {
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
  }

  .chevron-capitulo {
    font-size: 20px;
    color: var(--color-texto-muted);
  }

  .fila-prevista {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    box-sizing: border-box;
    opacity: 0.5;
  }

  .num-capitulo-previsto {
    color: var(--color-texto-muted);
