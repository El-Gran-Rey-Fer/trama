---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { cargarCapitulos, cargarCapitulosPrevistos } from "../../lib/capitulos";
import { rutaCapitulo } from "../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({
		params: { materia: m.data.slug },
		props: { materiaId: m.id },
	}));
}

const { materia } = Astro.params;
const { materiaId } = Astro.props;
const materiaEntry = await getEntry("materias", materiaId);
const eras = materiaEntry?.data.eras ?? [];
const capitulos = await cargarCapitulos(materiaId);
const capitulosPrevistos = await cargarCapitulosPrevistos(materiaId);
const datosCapitulos = capitulos.map((c) => ({ id: c.id, relatos: c.relatos }));
const numeroPorCapitulo = new Map(capitulos.map((c, i) => [c.id, i + 1]));

const nombreMateria = materiaEntry?.data.nombre ?? materia;
---

<Base titulo={`${nombreMateria} — modo aventura`} materiaSlug={materia}>
  <section id="capitulos" class="seccion-leer">
    <div class="cabecera-lista">
      <h1 class="titulo-lista">{nombreMateria}</h1>
    </div>
    {
      eras.map((era) => {
        const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
        const previstosDeEra = capitulosPrevistos.filter((c) => c.era === era.id);
        return (
          <div class="grupo-era">
            <h2 class="etiqueta-era">{era.nombre}</h2>
            {capitulosDeEra.length === 0 ? (
              <p class="sin-capitulos">Sin capítulos todavía.</p>
            ) : (
              <ol class="lista-capitulos">
                {capitulosDeEra.map((c) => (
                  <li data-capitulo={c.id} class="fila-capitulo">
                    <a href={rutaCapitulo(materia, c.id)} class="enlace-capitulo">
                      <span class="num-capitulo" aria-hidden="true">
                        {numeroPorCapitulo.get(c.id)}
                      </span>
                      <span class="texto-capitulo">
                        <span class="titulo-capitulo">{c.nombre}</span>
                        <span class="estado">Cerrado</span>
                      </span>
                      <span class="chevron-capitulo" aria-hidden="true">
                        ›
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
            {previstosDeEra.length > 0 && (
              <ol class="lista-capitulos lista-previstos">
                {previstosDeEra.map((c) => (
                  <li class="fila-prevista">
                    <span class="texto-capitulo">
                      <span class="titulo-capitulo">{c.nombre}</span>
                      <span class="estado">Próximamente</span>
                    </span>
                  </li>
                ))}
              </ol>
            )}
          </div>
        );
      })
    }
  </section>

  <script
    is:inline
    type="application/json"
    id="datos-capitulos"
    set:html={JSON.stringify(datosCapitulos)}
  />

  <script>
    import {
      calcularEstadosCapitulos,
      leerEstado,
      type CapituloResumen,
    } from "../../lib/estado";

    const ETIQUETA = {
      abierto: "Abierto",
      "en-curso": "En curso",
      cerrado: "Cerrado",
    } as const;

    const datosCapitulosEl = document.getElementById("datos-capitulos");
    const capitulos: CapituloResumen[] = datosCapitulosEl
      ? JSON.parse(datosCapitulosEl.textContent ?? "[]")
      : [];
    const estadosCapitulos = calcularEstadosCapitulos(capitulos, leerEstado());

    for (const [id, estado] of Object.entries(estadosCapitulos)) {
      const fila = document.querySelector(`[data-capitulo="${id}"]`);
      const el = fila?.querySelector(".estado");
      if (el) el.textContent = ETIQUETA[estado];
      if (fila instanceof HTMLElement) fila.dataset.estadoCapitulo = estado;
    }
  </script>
</Base>

<style>
  .cabecera-lista {
    padding: 20px 20px 4px;
  }

  .titulo-lista {
    margin: 0;
    font-size: 26px;
    font-weight: var(--peso-titulo-grande);
    font-family: var(--fuente-titulo);
    text-transform: capitalize;
  }

  .grupo-era {
    margin-bottom: 4px;
  }

  .etiqueta-era {
    margin: 18px 20px 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-acento);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--fuente-titulo);
  }

  .sin-capitulos {
    margin: 0 20px 12px;
    font-size: 13px;
    color: var(--color-texto-muted);
  }

  .lista-capitulos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fila-capitulo[data-estado-capitulo="cerrado"] {
    opacity: 0.6;
  }

  .enlace-capitulo {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    color: var(--color-texto);
    text-decoration: none;
    box-sizing: border-box;
  }

  .num-capitulo {
    flex: 0 0 auto;
    width: 28px;
    font-size: 22px;
    font-weight: 700;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
  }

  .texto-capitulo {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .titulo-capitulo {
    font-size: 17px;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .estado {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .chevron-capitulo {
    font-size: 20px;
    color: var(--color-texto-muted);
  }

  .lista-previstos .fila-prevista {
    display: flex;
    align-items: center;
    padding: 16px 20px 16px 62px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    opacity: 0.5;
  }
</style>
