---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { cargarCapitulos } from "../../lib/capitulos";
import { rutaCapitulo, rutaReto } from "../../lib/rutas";
import { generarTarjetas } from "../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({
		params: { materia: m.data.slug },
		props: { materiaId: m.id },
	}));
}

const { materia } = Astro.params;
const { materiaId } = Astro.props;
const materiaEntry = await getEntry("materias", materiaId);
const eras = materiaEntry?.data.eras ?? [];
const capitulos = await cargarCapitulos(materiaId);
const activos = capitulos.filter((c) => c.activo);
// era.posición sobre todos los capítulos, activos o no: la numeración ya
// refleja su lugar real en el mapa desde el primer día, y activar uno no
// corre la de los demás — el hueco ya estaba contado.
const numeroPorCapitulo = new Map<string, string>();
eras.forEach((era, indiceEra) => {
	const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
	capitulosDeEra.forEach((c, indiceCapitulo) => {
		numeroPorCapitulo.set(c.id, `${indiceEra + 1}.${indiceCapitulo + 1}`);
	});
});
// El recuento de contenido (sandbox, plan de gamificación §5) se calcula aquí
// —en build, no en cliente— y viaja en el mismo JSON que ya usaba el
// vocabulario de aventura: mismo patrón que examen.astro:37 con
// `generarTarjetas`. `numero` (era.posición) viaja también, para el módulo
// de continuación (§6) — sin recalcularlo en cliente.
const datosCapitulos = await Promise.all(
	activos.map(async (c) => ({
		id: c.id,
		nombre: c.nombre,
		numero: numeroPorCapitulo.get(c.id) ?? "",
		relatos: c.relatosResumen,
		recuento: {
			relatos: c.relatosEscritos.length,
			entidades: c.conjunto.size,
			tarjetas: (await generarTarjetas(materiaId, c.conjunto)).length,
		},
	})),
);

const nombreMateria = materiaEntry?.data.nombre ?? materia;
---

<Base titulo={`${nombreMateria} — modo aventura`} materiaSlug={materia}>
  <section id="continua" class="seccion-continua" hidden>
    <p class="continua-etiqueta">Continúa</p>
    <a id="continua-enlace" class="continua-fila" href="#">
      <span class="continua-texto">
        <span id="continua-numero" class="continua-numero"></span>
        <span id="continua-nombre" class="continua-nombre"></span>
        <span id="continua-detalle" class="continua-detalle"></span>
      </span>
      <span class="continua-boton">Seguir &rarr;</span>
    </a>
  </section>

  <!--
    Reto del día (bloque Z, §9): módulo secundario, siempre por debajo del de
    continuación — nunca lo primero, para que no parezca la vía principal.
    Visible en los dos modos: no depende de la progresión de aventura, solo
    la respeta cuando la hay.
  -->
  <section class="seccion-reto">
    <a class="reto-fila" href={rutaReto(materia)}>
      <span class="reto-texto">
        <span class="reto-etiqueta">Reto del día</span>
        <span id="reto-detalle" class="reto-detalle">Cinco preguntas rápidas con lo que ya tienes.</span>
      </span>
      <span class="reto-boton">Jugar &rarr;</span>
    </a>
  </section>

  <section id="capitulos" class="seccion-leer">
    <div class="cabecera-lista">
      <h1 class="titulo-lista">{nombreMateria}</h1>
    </div>
    {
      eras.map((era) => {
        const capitulosDeEra = capitulos.filter((c) => c.era === era.id);
        return (
          <div class="grupo-era">
            <h2 class="etiqueta-era">{era.nombre}</h2>
            {capitulosDeEra.length === 0 ? (
              <p class="sin-capitulos">Sin capítulos todavía.</p>
            ) : (
              <ol class="lista-capitulos">
                {capitulosDeEra.map((c) =>
                  c.activo ? (
                    <li data-capitulo={c.id} class="fila-capitulo">
                      <a href={rutaCapitulo(materia, c.id)} class="enlace-capitulo">
                        <span class="num-capitulo" aria-hidden="true">
                          {numeroPorCapitulo.get(c.id)}
                        </span>
                        <span class="texto-capitulo">
                          <span class="titulo-capitulo">{c.nombre}</span>
                          <span class="estado">Bloqueado</span>
                        </span>
                        <span class="chevron-capitulo" aria-hidden="true">
                          ›
                        </span>
                      </a>
                    </li>
                  ) : (
                    <li class="fila-prevista">
                      <span class="num-capitulo num-capitulo-previsto" aria-hidden="true">
                        {numeroPorCapitulo.get(c.id)}
                      </span>
                      <span class="texto-capitulo">
                        <span class="titulo-capitulo">{c.nombre}</span>
                        <span class="estado">Próximamente</span>
                      </span>
                    </li>
                  ),
                )}
              </ol>
            )}
          </div>
        );
      })
    }
  </section>

  <script
    is:inline
    type="application/json"
    id="datos-capitulos"
    set:html={JSON.stringify(datosCapitulos)}
  />

  <script>
    import {
      calcularEstadosCapitulos,
      leerEstado,
      type CapituloResumen,
    } from "../../lib/estado";
    import { calcularPasoAccionable } from "../../lib/muroCliente";

    const ETIQUETA = {
      bloqueado: "Bloqueado",
      abierto: "Abierto",
      "en-curso": "En curso",
      superado: "Superado",
    } as const;

    interface RecuentoCapitulo {
      relatos: number;
      entidades: number;
      tarjetas: number;
    }
    interface DatosCapitulo extends CapituloResumen {
      numero: string;
      recuento: RecuentoCapitulo;
    }

    function pluralizar(cantidad: number, singular: string, plural: string): string {
      return `${cantidad} ${cantidad === 1 ? singular : plural}`;
    }

    // Sandbox no tiene progresión (plan de gamificación §5): donde aventura
    // muestra estado, sandbox muestra peso de contenido — es lo que un lector
    // de enciclopedia quiere antes de entrar.
    function textoRecuento(r: RecuentoCapitulo): string {
      return [
        pluralizar(r.relatos, "relato", "relatos"),
        pluralizar(r.entidades, "entidad", "entidades"),
        pluralizar(r.tarjetas, "tarjeta", "tarjetas"),
      ].join(" · ");
    }

    const datosCapitulosEl = document.getElementById("datos-capitulos");
    const capitulos: DatosCapitulo[] = datosCapitulosEl
      ? JSON.parse(datosCapitulosEl.textContent ?? "[]")
      : [];
    const estado = leerEstado();
    const materiaSlug = document.documentElement.dataset.materia ?? "";

    const hoy = new Date().toISOString().slice(0, 10);
    const elRetoDetalle = document.getElementById("reto-detalle");
    if (elRetoDetalle) {
      elRetoDetalle.textContent =
        estado.retos.ultimaFecha === hoy
          ? `Ya lo hiciste hoy (${estado.retos.completados} en total) — repítelo si quieres.`
          : `Cinco preguntas rápidas con lo que ya tienes. Llevas ${estado.retos.completados}.`;
    }

    if (estado.modo === "sandbox") {
      for (const c of capitulos) {
        const fila = document.querySelector(`[data-capitulo="${c.id}"]`);
        const el = fila?.querySelector(".estado");
        if (el) el.textContent = textoRecuento(c.recuento);
      }
    } else {
      const estadosCapitulos = calcularEstadosCapitulos(capitulos, estado);
      for (const [id, estadoCapitulo] of Object.entries(estadosCapitulos)) {
        const fila = document.querySelector(`[data-capitulo="${id}"]`);
        const el = fila?.querySelector(".estado");
        if (el) el.textContent = ETIQUETA[estadoCapitulo];
        if (fila instanceof HTMLElement) {
          fila.dataset.estadoCapitulo = estadoCapitulo;
        }
      }

      // Módulo de continuación (§6): solo en aventura, y solo si queda algún
      // paso pendiente — reutiliza el mismo cálculo que el muro (§4.3), cero
      // lógica duplicada.
      const paso = calcularPasoAccionable(capitulos, estado, materiaSlug);
      if (paso) {
        const numero = capitulos.find((c) => c.id === paso.capituloId)?.numero ?? "";
        document.getElementById("continua-numero")!.textContent = numero ? `${numero} · ` : "";
        document.getElementById("continua-nombre")!.textContent = paso.capituloNombre;
        document.getElementById("continua-detalle")!.textContent = ` — ${paso.detalle}`;
        const enlace = document.getElementById("continua-enlace");
        if (enlace instanceof HTMLAnchorElement) enlace.href = paso.hrefAccion;
        document.getElementById("continua")?.removeAttribute("hidden");
      }
    }
  </script>
</Base>

<style>
  .seccion-continua {
    margin: 16px 20px 0;
  }

  .continua-etiqueta {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-texto-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .continua-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: var(--color-tarjeta-fondo);
    color: var(--color-texto);
    text-decoration: none;
  }

  .continua-texto {
    display: block;
    font-size: 15px;
  }

  .continua-numero,
  .continua-nombre {
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .continua-detalle {
    color: var(--color-texto-muted);
  }

  .continua-boton {
    flex: 0 0 auto;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 14px;
  }

  .seccion-reto {
    margin: 10px 20px 0;
  }

  .reto-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: none;
    color: var(--color-texto);
    text-decoration: none;
  }

  .reto-texto {
    display: block;
    font-size: 13px;
  }

  .reto-etiqueta {
    display: block;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .reto-detalle {
    color: var(--color-texto-muted);
  }

  .reto-boton {
    flex: 0 0 auto;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 13px;
  }

  .cabecera-lista {
    padding: 20px 20px 4px;
  }

  .titulo-lista {
    margin: 0;
    font-size: 26px;
    font-weight: var(--peso-titulo-grande);
    font-family: var(--fuente-titulo);
    text-transform: capitalize;
  }

  .grupo-era {
    margin-bottom: 4px;
  }

  .etiqueta-era {
    margin: 18px 20px 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-acento);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--fuente-titulo);
  }

  .sin-capitulos {
    margin: 0 20px 12px;
    font-size: 13px;
    color: var(--color-texto-muted);
  }

  .lista-capitulos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fila-capitulo[data-estado-capitulo="bloqueado"] {
    opacity: 0.6;
  }

  .enlace-capitulo {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    color: var(--color-texto);
    text-decoration: none;
    box-sizing: border-box;
  }

  .num-capitulo {
    flex: 0 0 auto;
    min-width: 28px;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
  }

  .texto-capitulo {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .titulo-capitulo {
    font-size: 17px;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .estado {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .chevron-capitulo {
    font-size: 20px;
    color: var(--color-texto-muted);
  }

  .fila-prevista {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    box-sizing: border-box;
    opacity: 0.5;
  }

  .num-capitulo-previsto {
    color: var(--color-texto-muted);
  }
</style>
