---
import { getCollection, getEntry, render } from "astro:content";
import E from "../../../components/E.astro";
import Fuente from "../../../components/Fuente.astro";
import LayoutLectura from "../../../layouts/LayoutLectura.astro";
import {
	capitulosQueDesbloquean,
	cargarCapitulos,
	construirCadena,
} from "../../../lib/capitulos";
import { relatosDeMateria } from "../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";
import { resolverRetrato } from "../../../lib/retrato";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const relatos = await relatosDeMateria(m.id);
			return relatos.map((r) => ({
				params: { materia: m.data.slug, id: r.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;
const relatos = await relatosDeMateria(materiaId);
const entrada = relatos.find((r) => r.id === id);
if (!entrada) throw new Error(`Relato no encontrado: ${id}`);

const { Content } = await render(entrada);

const grafo = await construirGrafo(materiaId);

const materiaEntry = await getEntry("materias", materiaId);
const era = entrada.data.era
	? (materiaEntry?.data.eras?.find((e) => e.id === entrada.data.era)?.nombre ??
		null)
	: null;

const participantes = (entrada.data.participantes ?? []).map((pid) => {
	const nodo = obtenerEntidad(grafo, pid);
	return {
		id: pid,
		nombre: nodo?.nombre ?? pid,
		tipo: nodo?.tipo ?? "",
		retrato: nodo ? resolverRetrato(grafo, nodo) : undefined,
	};
});
const lugar = entrada.data.lugar
	? {
			id: entrada.data.lugar,
			nombre:
				obtenerEntidad(grafo, entrada.data.lugar)?.nombre ?? entrada.data.lugar,
		}
	: null;

// Un relato no conoce su capítulo (la relación vive al revés, en
// materia.yaml: capitulos[].relatos) — se resuelve aquí para el back-link y
// el CTA de examen.
const capitulos = await cargarCapitulos(materiaId);
const capituloPadre = capitulos.find((c) => c.relatos.includes(id));

// Muro de aventura (bloque W): un relato lo desbloquea únicamente el
// capítulo que lo declara.
const cadena = construirCadena(capitulos);
const desbloqueadoPor = capituloPadre ? [capituloPadre.id] : [];

// Silueta de participante bloqueado (propuesta de Design, mismo patrón que
// e/[id].astro): para cada participante, los capítulos que lo desbloquean —
// nunca el `conjunto` completo, solo lo que hace falta para esta lista.
const destinosParticipantes: Record<string, string[]> = {};
for (const p of participantes) {
	destinosParticipantes[p.id] = capitulosQueDesbloquean(
		capitulos,
		p.id,
		obtenerEntidad(grafo, p.id)?.kind === "relato" ? "relato" : "entidad",
	);
}
---

<LayoutLectura
  id={entrada.id}
  titulo={entrada.data.nombre}
  resumen={entrada.data.resumen}
  materiaSlug={materia}
  era={era}
  participantes={participantes}
  lugar={lugar}
  capituloId={capituloPadre?.id}
  capituloNombre={capituloPadre?.nombre}
  cadenaCapitulos={cadena}
  capitulosQueDesbloquean={desbloqueadoPor}
  destinosParticipantes={destinosParticipantes}
>
  <Content components={{ E, Fuente }} />
</LayoutLectura>
