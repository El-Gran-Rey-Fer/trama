---
import { getCollection, getEntry, render } from "astro:content";
import E from "../../../components/E.astro";
import Fuente from "../../../components/Fuente.astro";
import LayoutLectura from "../../../layouts/LayoutLectura.astro";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";
import { resolverRetrato } from "../../../lib/retrato";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const relatos = await getCollection("relatos");
	return materias.flatMap((m) =>
		relatos.map((r) => ({
			params: { materia: m.data.slug, id: r.id },
			props: { materiaId: m.id },
		})),
	);
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;
const relatos = await getCollection("relatos");
const entrada = relatos.find((r) => r.id === id);
if (!entrada) throw new Error(`Relato no encontrado: ${id}`);

const { Content } = await render(entrada);

const grafo = await construirGrafo(materiaId);

const materiaEntry = await getEntry("materias", materiaId);
const era = entrada.data.era
	? (materiaEntry?.data.eras?.find((e) => e.id === entrada.data.era)?.nombre ??
		null)
	: null;

const participantes = (entrada.data.participantes ?? []).map((pid) => {
	const nodo = obtenerEntidad(grafo, pid);
	return {
		id: pid,
		nombre: nodo?.nombre ?? pid,
		tipo: nodo?.tipo ?? "",
		retrato: nodo ? resolverRetrato(grafo, nodo) : undefined,
	};
});
const lugar = entrada.data.lugar
	? {
			id: entrada.data.lugar,
			nombre:
				obtenerEntidad(grafo, entrada.data.lugar)?.nombre ?? entrada.data.lugar,
		}
	: null;
---

<LayoutLectura
  id={entrada.id}
  titulo={entrada.data.nombre}
  resumen={entrada.data.resumen}
  materiaSlug={materia}
  era={era}
  participantes={participantes}
  lugar={lugar}
>
  <Content components={{ E, Fuente }} />
</LayoutLectura>
