---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import { cargarCapitulos } from "../../../../lib/capitulos";
import type { PreguntaMixta } from "../../../../lib/examenMixtoCliente";
import { generarRondasIdentificar } from "../../../../lib/identificar";
import { generarRondasArbol } from "../../../../lib/juegoArbol";
import { generarPertenencia } from "../../../../lib/pertenencia";
import { rutaCapitulo } from "../../../../lib/rutas";
import { generarTarjetas } from "../../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const capitulos = await cargarCapitulos(m.id);
			return capitulos.map((c) => ({
				params: { materia: m.data.slug, id: c.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const capitulos = await cargarCapitulos(materiaId);
const indice = capitulos.findIndex((c) => c.id === id);
const capitulo = capitulos[indice];
if (!capitulo) throw new Error(`Capítulo no encontrado: ${id}`);
const siguienteCapitulo = capitulos[indice + 1] ?? null;

const tarjetas = await generarTarjetas(materiaId, capitulo.conjunto);
const pertenencia = await generarPertenencia(materiaId, capitulo.conjunto);
// juegoArbol.ts e identificar.ts no aceptan scope: se filtran aquí con el
// mismo contrato `ids: string[]` que ya usa tarjetasDisponibles.ts.
const rondasArbol = (await generarRondasArbol(materiaId)).filter((r) =>
	r.ids.every((rid) => capitulo.conjunto.has(rid)),
);
const rondasIdentificar = (await generarRondasIdentificar(materiaId)).filter(
	(r) => r.ids.every((rid) => capitulo.conjunto.has(rid)),
);

// Examen mixto (todos los tipos de juego que son pregunta-y-respuesta de una
// sola ronda): solo entran preguntas evaluables de verdad (nada se
// autoevalúa, §3.5). De `tarjetas`, solo las de respuesta única y con al
// menos un distractor real. El resto del contenido del capítulo se practica
// en /practicar, pero no examina.
const preguntas: PreguntaMixta[] = [
	...tarjetas
		.filter((t) => !t.conjunto && t.distractores.length > 0)
		.map((tarjeta): PreguntaMixta => ({ tipo: "opcion-multiple", tarjeta })),
	...pertenencia.map(
		(ronda): PreguntaMixta => ({ tipo: "pertenencia", ronda }),
	),
	...rondasArbol.map((ronda): PreguntaMixta => ({ tipo: "arbol", ronda })),
	...rondasIdentificar.map(
		(ronda): PreguntaMixta => ({ tipo: "identificar", ronda }),
	),
];
---

<Base titulo={`Examen — ${capitulo.nombre}`} materiaSlug={materia}>
  <article class="examen">
    <header class="cabecera-juego">
      <a class="salir" href={rutaCapitulo(materia, capitulo.id)}>&lsaquo; Salir</a>
      <div class="titulo-wrap">
        <h1>Examen: {capitulo.nombre}</h1>
      </div>
      <p id="progreso" class="progreso"></p>
    </header>

    <div id="tablero"></div>

    <p id="sin-preguntas" hidden>
      Este capítulo todavía no tiene suficientes tarjetas evaluables para un
      examen. Vuelve cuando tenga más contenido.
    </p>
  </article>

  <script
    is:inline
    type="application/json"
    id="datos-examen"
    set:html={JSON.stringify({
      preguntas,
      umbral: capitulo.examen,
      capituloId: capitulo.id,
      idSiguiente: siguienteCapitulo?.id ?? null,
      nombreSiguiente: siguienteCapitulo?.nombre ?? null,
      materiaSlug: materia,
    })}
  />

  <script>
    import { guardarEstado, leerEstado } from "../../../../lib/estado";
    import {
      iniciarExamenMixto,
      type PreguntaMixta,
    } from "../../../../lib/examenMixtoCliente";
    import { rutaCapitulo, rutaMateria } from "../../../../lib/rutas";

    interface Datos {
      preguntas: PreguntaMixta[];
      umbral: { aciertos: number; de: number };
      capituloId: string;
      idSiguiente: string | null;
      nombreSiguiente: string | null;
      materiaSlug: string;
    }

    const datosEl = document.getElementById("datos-examen");
    const datos = datosEl
      ? (JSON.parse(datosEl.textContent ?? "{}") as Datos)
      : null;

    const tablero = document.getElementById("tablero");
    const elProgreso = document.getElementById("progreso");
    const elSinPreguntas = document.getElementById("sin-preguntas");

    function mostrarResultado(
      resultado: {
        aciertos: number;
        total: number;
        necesarios: number;
        superado: boolean;
        falladas: { textoPregunta: string; textoRespuesta: string }[];
      },
      reintentar: () => void,
    ) {
      if (!tablero || !datos) return;
      tablero.innerHTML = "";

      const resumen = document.createElement("p");
      resumen.className = "resultado";
      resumen.textContent = `${resultado.aciertos} / ${resultado.total} correctas.`;
      tablero.appendChild(resumen);

      const estado = leerEstado();
      const previo = estado.capitulos[datos.capituloId];
      estado.capitulos[datos.capituloId] = {
        estado: resultado.superado ? "cerrado" : (previo?.estado ?? "en-curso"),
        intentos: (previo?.intentos ?? 0) + 1,
      };
      guardarEstado(estado);

      if (resultado.superado) {
        const exito = document.createElement("p");
        exito.className = "exito";
        exito.textContent = "¡Capítulo superado!";
        tablero.appendChild(exito);

        const enlace = document.createElement("a");
        enlace.className = "boton-siguiente";
        if (datos.idSiguiente) {
          enlace.href = rutaCapitulo(datos.materiaSlug, datos.idSiguiente);
          enlace.textContent = `Siguiente: ${datos.nombreSiguiente}`;
        } else {
          enlace.href = rutaMateria(datos.materiaSlug);
          enlace.textContent = "Volver al mapa";
        }
        tablero.appendChild(enlace);
      } else {
        const aviso = document.createElement("p");
        aviso.textContent = `No llegaste al umbral (${resultado.necesarios}). Repasa esto antes de reintentar:`;
        tablero.appendChild(aviso);

        const listaFalladas = document.createElement("ul");
        listaFalladas.className = "lista-falladas";
        for (const f of resultado.falladas) {
          const item = document.createElement("li");
          item.textContent = `${f.textoPregunta} → ${f.textoRespuesta}`;
          listaFalladas.appendChild(item);
        }
        tablero.appendChild(listaFalladas);

        const reintentarBoton = document.createElement("button");
        reintentarBoton.type = "button";
        reintentarBoton.className = "boton-siguiente";
        reintentarBoton.textContent = "Reintentar";
        reintentarBoton.addEventListener("click", reintentar);
        tablero.appendChild(reintentarBoton);
      }
    }

    if (datos && tablero) {
      iniciarExamenMixto({
        tablero,
        elProgreso,
        elSinPreguntas,
        preguntas: datos.preguntas,
        umbral: datos.umbral,
        onResultado: mostrarResultado,
      });
    }
  </script>

  <!--
    is:global: examenMixtoCliente.ts crea el tablero entero con
    document.createElement, en tiempo de cliente — a esos nodos nunca les
    llega el atributo data-astro-cid-* que necesita un <style> con scope de
    componente para aplicar nada (mismo problema, y misma solución, que
    .mini-ficha en Base.astro). Solo afecta a esta página: Astro solo
    enlaza esta hoja de estilos en el HTML de esta ruta.
  -->
  <style is:global>
    .cabecera-juego {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 12px 20px 6px;
    }

    .salir {
      flex: 0 0 auto;
      color: var(--color-acento);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
    }

    .titulo-wrap {
      flex: 1;
      text-align: center;
    }

    .titulo-wrap h1 {
      margin: 0;
      font-size: 18px;
      font-family: var(--fuente-titulo);
    }

    .progreso {
      flex: 0 0 auto;
      margin: 0;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-texto-muted);
      font-family: var(--fuente-titulo);
    }

    .texto-pregunta {
      padding: 0 20px;
      font-size: 18px;
      font-weight: 600;
    }

    #sin-preguntas {
      padding: 0 20px;
      color: var(--color-texto-muted);
    }

    .opciones {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 12px 20px;
    }

    .opcion {
      padding: 14px;
      border: 1px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente);
      font-size: 15px;
      text-align: left;
      cursor: pointer;
    }

    .opcion.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 15%, var(--color-tarjeta-fondo));
      animation: destello-acierto 0.3s ease;
    }

    .opcion.fallo {
      border-color: var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .opcion:disabled {
      cursor: default;
    }

    /* Examen mixto: feedback + botón "Siguiente" tras cada ronda, y las
       cuatro rondas no-opción-múltiple que puede mezclar, portadas de
       [juego].astro (mismo lenguaje visual que ya usa Practicar). */
    .feedback {
      margin: 16px 20px 0;
      padding: 14px;
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      font-size: 14px;
      line-height: 1.5;
      color: var(--color-texto);
    }

    .feedback.acierto {
      border: 1px solid var(--color-acierto);
      animation: destello-acierto 0.3s ease;
    }

    .feedback.fallo {
      border: 1px solid var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .tarjeta-pertenencia {
      margin: 0 20px 18px;
      padding: 20px;
      border: 1px solid var(--color-tarjeta-borde);
      border-left-width: 4px;
      border-left-color: var(--color-acento);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente-titulo);
      font-size: 19px;
      font-weight: 700;
      line-height: 1.3;
    }

    .opciones-pertenencia {
      display: flex;
      gap: 12px;
      padding: 0 20px;
    }

    .opcion-pertenencia {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 22px 14px;
      border: 1.5px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-fondo-pantalla);
      color: var(--color-texto);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .icono-pertenencia {
      font-size: 26px;
      color: var(--color-texto-muted);
    }

    .opcion-pertenencia.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 12%, var(--color-fondo-pantalla));
      animation: destello-acierto 0.3s ease;
    }

    .opcion-pertenencia.acierto .icono-pertenencia {
      color: var(--color-acierto);
    }

    .opcion-pertenencia.fallo {
      border-color: var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .opcion-pertenencia.fallo .icono-pertenencia {
      color: var(--color-fallo);
    }

    .opcion-pertenencia:disabled {
      cursor: default;
    }

    .arbol-juego-scroll {
      overflow-x: auto;
      padding: 16px 20px 4px;
    }

    .arbol-juego-lienzo {
      position: relative;
      margin: 0 auto;
    }

    .arbol-juego-svg {
      position: absolute;
      inset: 0;
      overflow: visible;
    }

    .arbol-juego-svg line {
      stroke: var(--color-tarjeta-borde);
      stroke-width: 2;
    }

    .arbol-juego-nodo {
      position: absolute;
      transform: translate(-50%, -50%);
      width: 64px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .arbol-juego-casilla {
      width: 64px;
    }

    .arbol-juego-nodo.raiz .arbol-juego-casilla,
    .arbol-juego-nodo.raiz .arbol-juego-hueco {
      outline: 2px solid var(--color-acento);
      outline-offset: 2px;
    }

    .arbol-juego-nombre {
      font-size: 11px;
      text-align: center;
      line-height: 1.2;
      color: var(--color-texto);
    }

    .arbol-juego-hueco {
      width: 64px;
      aspect-ratio: 1;
      border-radius: var(--radio);
      border: 2px dashed var(--color-acento);
      background: var(--color-tarjeta-fondo);
      color: var(--color-acento);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 700;
    }

    .arbol-juego-casilla.acierto .casilla-inicial {
      outline: 2px solid var(--color-acierto);
      outline-offset: -2px;
      animation: destello-acierto 0.3s ease;
    }

    .arbol-juego-casilla.fallo .casilla-inicial {
      outline: 2px solid var(--color-fallo);
      outline-offset: -2px;
      animation: agitar-fallo 0.3s ease;
    }

    .opciones-arbol {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 16px 20px;
    }

    .opcion-arbol {
      flex: 1 1 40%;
      padding: 14px;
      border: 1px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .opcion-arbol.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 15%, var(--color-tarjeta-fondo));
      animation: destello-acierto 0.3s ease;
    }

    .opcion-arbol.fallo {
      border-color: var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .figura-identificar {
      position: relative;
      overflow: hidden;
      margin: 0 0 16px;
      line-height: 0;
    }

    .figura-identificar img {
      display: block;
      width: 100%;
      height: auto;
    }

    .marco-identificar {
      position: absolute;
      border: 3px solid var(--color-acento);
      border-radius: 4px;
      box-shadow: 0 0 0 999px rgb(0 0 0 / 45%);
      pointer-events: none;
    }

    .marca-identificar {
      position: absolute;
      width: 18px;
      height: 18px;
      transform: translate(-50%, -50%);
      border: 3px solid var(--color-acento);
      border-radius: 50%;
      background: color-mix(in srgb, var(--color-acento) 30%, transparent);
      pointer-events: none;
    }

    .pregunta-identificar {
      margin: 0 20px 14px;
      font-family: var(--fuente-titulo);
      font-size: 18px;
      font-weight: 700;
    }

    .opciones-identificar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 0 20px;
    }

    .opcion-identificar {
      padding: 14px 10px;
      border: 1.5px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-fondo-pantalla);
      color: var(--color-texto);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      cursor: pointer;
    }

    .opcion-identificar.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 12%, var(--color-fondo-pantalla));
      animation: destello-acierto 0.3s ease;
    }

    .opcion-identificar.fallo {
      border-color: var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .opcion-identificar:disabled {
      cursor: default;
    }

    .resultado {
      margin: 0 20px 14px;
      padding: 0;
      font-size: 20px;
      font-weight: 800;
      text-align: center;
      font-family: var(--fuente-titulo);
    }

    .exito {
      margin: 0 20px 14px;
      padding: 0;
      color: var(--color-acento);
      font-weight: 800;
      text-align: center;
      font-size: 18px;
      font-family: var(--fuente-titulo);
    }

    #tablero > p:not(.resultado):not(.exito):not(.feedback):not(.tarjeta-pertenencia):not(.pregunta-identificar) {
      margin: 0 20px 14px;
      color: var(--color-texto-muted);
      font-size: 14px;
    }

    .lista-falladas {
      margin: 0 20px 18px;
      padding: 14px 14px 14px 34px;
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-size: 14px;
      line-height: 1.5;
    }

    .boton-siguiente {
      display: block;
      width: calc(100% - 40px);
      margin: 0 20px 28px;
      padding: 14px 20px;
      border: none;
      border-radius: var(--radio);
      background: var(--color-acento);
      color: var(--color-acento-contraste);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    @keyframes destello-acierto {
      0% {
        transform: scale(1);
      }
      40% {
        transform: scale(1.05);
      }
      100% {
        transform: scale(1);
      }
    }

    @keyframes agitar-fallo {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-4px);
      }
      75% {
        transform: translateX(4px);
      }
    }
  </style>
</Base>
