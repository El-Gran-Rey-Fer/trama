---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import { cargarCapitulos } from "../../../../lib/capitulos";
import { relatosDeMateria } from "../../../../lib/contenidoPorMateria";
import { conjuntoDeRelato } from "../../../../lib/desbloqueo";
import { rutaCapitulo } from "../../../../lib/rutas";
import { generarTarjetas } from "../../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const capitulos = await cargarCapitulos(m.id);
			return capitulos
				.filter((c) => c.activo)
				.map((c) => ({
					params: { materia: m.data.slug, id: c.id },
					props: { materiaId: m.id },
				}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const capitulos = await cargarCapitulos(materiaId);
const capitulo = capitulos.find((c) => c.id === id);
if (!capitulo) throw new Error(`Capítulo no encontrado: ${id}`);

// Sandbox diferencial (plan de gamificación §5): mismo mazo de tarjeta-flip
// que /practicar (mazo suelto de materia), acotado al conjunto de este
// capítulo — mismo patrón que examen.astro:37 con `generarTarjetas`.
const tarjetas = await generarTarjetas(materiaId, capitulo.conjunto);
const relatos = await relatosDeMateria(materiaId);
const relatoConjuntos = Object.fromEntries(
	relatos.map((r) => [r.id, conjuntoDeRelato(r.data)]),
);
---

<Base titulo={`Practicar — ${capitulo.nombre}`} materiaSlug={materia}>
  <article class="juego">
    <header class="cabecera-juego">
      <a class="salir" href={rutaCapitulo(materia, capitulo.id)}>&lsaquo; Salir</a>
      <div class="titulo-wrap">
        <h1>{capitulo.nombre}</h1>
      </div>
      <p id="progreso" class="progreso"></p>
    </header>

    <div class="contenido-tarjeta">
      <button id="tarjeta" type="button" class="tarjeta-flip">
        <span id="eyebrow" class="eyebrow-tarjeta"></span>
        <span id="texto-tarjeta" class="texto-tarjeta"></span>
        <span id="hint" class="hint-tarjeta"></span>
      </button>

      <button id="siguiente" type="button" class="siguiente-pregunta">Siguiente tarjeta</button>
    </div>

    <p id="vacio" class="vacio" hidden>
      No hay tarjetas disponibles todavía en este capítulo.
    </p>
  </article>

  <script
    is:inline
    type="application/json"
    id="datos-practicar"
    set:html={JSON.stringify({ tarjetas, relatoConjuntos })}
  />

  <script>
    import { montarPracticar } from "../../../../lib/practicarCliente";
    montarPracticar();
  </script>

  <style>
    .cabecera-juego {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 12px 20px 6px;
    }

    .salir {
      flex: 0 0 auto;
      color: var(--color-acento);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
    }

    .titulo-wrap {
      flex: 1;
      text-align: center;
    }

    .titulo-wrap h1 {
      margin: 0;
      font-size: 18px;
      font-family: var(--fuente-titulo);
    }

    .progreso {
      flex: 0 0 auto;
      margin: 0;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-texto-muted);
      font-family: var(--fuente-titulo);
    }

    .contenido-tarjeta {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 10px 20px 28px;
    }

    .tarjeta-flip {
      width: 100%;
      min-height: 220px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 28px 20px;
      border: 1px solid var(--color-tarjeta-borde);
      border-top-width: 5px;
      border-top-color: var(--color-acento);
      border-radius: var(--radio);
      background: var(--color-fondo-pantalla);
      color: var(--color-texto);
      font-family: var(--fuente);
      text-align: center;
      cursor: pointer;
    }

    .tarjeta-flip.volteada {
      border-top-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 8%, var(--color-fondo-pantalla));
    }

    .eyebrow-tarjeta {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--color-acento);
      text-transform: uppercase;
    }

    .tarjeta-flip.volteada .eyebrow-tarjeta {
      color: var(--color-acierto);
    }

    .texto-tarjeta {
      font-size: 19px;
      font-weight: 700;
      font-family: var(--fuente-titulo);
      color: var(--color-texto);
      line-height: 1.3;
    }

    .tarjeta-flip.volteada .texto-tarjeta {
      font-size: 24px;
      font-weight: 800;
    }

    .hint-tarjeta {
      margin-top: 6px;
      font-size: 12px;
      color: var(--color-texto-muted);
    }

    .siguiente-pregunta {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: var(--radio);
      background: var(--color-acento);
      color: var(--color-acento-contraste);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .vacio {
      padding: 0 20px;
      color: var(--color-texto-muted);
    }
  </style>
</Base>
