---
import { getCollection } from "astro:content";
import Casilla from "../../../components/Casilla.astro";
import Muro from "../../../components/Muro.astro";
import Base from "../../../layouts/Base.astro";
import { cargarCapitulos, construirCadena } from "../../../lib/capitulos";
import { relatosDeMateria } from "../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";
import { resolverRetrato } from "../../../lib/retrato";
import {
	rutaExamen,
	rutaMateria,
	rutaPracticarCapitulo,
	rutaRelato,
} from "../../../lib/rutas";
import { generarTarjetas } from "../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const capitulos = await cargarCapitulos(m.id);
			// Un capítulo sin ningún relato escrito no tiene página propia — es
			// solo un nombre en la lista de "Próximamente" de la portada.
			return capitulos
				.filter((c) => c.activo)
				.map((c) => ({
					params: { materia: m.data.slug, id: c.id },
					props: { materiaId: m.id },
				}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const capitulos = await cargarCapitulos(materiaId);
const capitulo = capitulos.find((c) => c.id === id);
if (!capitulo) throw new Error(`Capítulo no encontrado: ${id}`);

const relatosCol = await relatosDeMateria(materiaId);
const relatosPorId = new Map(relatosCol.map((r) => [r.id, r.data]));

// Un relato es un nodo del grafo con pleno derecho (`kind: "relato"`), así que
// `resolverRetrato` ya funciona sobre él sin cambios: si alguna obra lo
// `representa`, la fila muestra esa imagen en vez del número.
const grafo = await construirGrafo(materiaId);
// Sin nombre propio todavía: aproxima uno legible a partir del id previsto,
// hasta que el relato exista y traiga el suyo.
const humanizarId = (id: string) =>
	id.charAt(0).toUpperCase() + id.slice(1).replaceAll("-", " ");
const relatos = capitulo.relatos.map((rid) => {
	const escrito = relatosPorId.has(rid);
	const nodo = escrito ? obtenerEntidad(grafo, rid) : undefined;
	return {
		id: rid,
		nombre: relatosPorId.get(rid)?.nombre ?? humanizarId(rid),
		tipo: nodo?.tipo ?? "desconocido",
		retrato: nodo ? resolverRetrato(grafo, nodo) : undefined,
		// Un capítulo activo puede tener relatos previstos que aún no se han
		// escrito — nunca enlazan a una página que no existe.
		escrito,
	};
});

const tarjetas = await generarTarjetas(materiaId, capitulo.conjunto);

// Muro de aventura (bloque W): esta página solo enseña ESTE capítulo, así
// que solo su propio id puede desbloquearla.
const cadena = construirCadena(capitulos);
---

<Base titulo={capitulo.nombre} materiaSlug={materia}>
  <Muro cadena={cadena} capitulosQueDesbloquean={[capitulo.id]} materiaSlug={materia}>
  <article class="pagina-capitulo">
    <div class="cabecera-lista">
      <h1 class="titulo-lista">{capitulo.nombre}</h1>
      <p class="subtitulo-lista">{capitulo.resumen}</p>
    </div>

    <ol class="lista-relatos">
      {
        relatos.map((r, i) =>
          r.escrito ? (
            <li data-relato={r.id} class="fila-relato">
              <a href={rutaRelato(materia, r.id)} class="enlace-relato">
                {r.retrato ? (
                  <span class="miniatura-relato">
                    <Casilla nombre={r.nombre} tipo={r.tipo} retrato={r.retrato} />
                  </span>
                ) : (
                  <span class="num-relato" aria-hidden="true">
                    {i + 1}
                  </span>
                )}
                <span class="texto-relato">
                  <span class="titulo-relato">{r.nombre}</span>
                  <span class="estado-relato" />
                </span>
                <span class="chevron-relato" aria-hidden="true">
                  ›
                </span>
              </a>
            </li>
          ) : (
            <li class="fila-relato fila-relato-prevista">
              <span class="texto-relato">
                <span class="titulo-relato">{r.nombre}</span>
                <span class="estado-relato">Próximamente</span>
              </span>
            </li>
          ),
        )
      }
    </ol>

    <div class="tarjeta-info">
      <span class="info-numero">{tarjetas.length}</span>
      <span class="info-etiqueta">tarjetas en este capítulo</span>
    </div>

    <div id="bloque-examen" class="tarjeta-examen">
      <p class="examen-umbral">
        Aprueba con {capitulo.examen.aciertos} de {capitulo.examen.de}.
      </p>
      <a
        class="boton-examen"
        id="boton-examen"
        href={rutaExamen(materia, capitulo.id)}
        aria-disabled="true"
        tabindex="-1"
      >
        Empezar el examen
      </a>
      <p id="examen-pendiente-texto" class="examen-pendiente-texto" hidden>
        Lee lo que falta para desbloquear el examen:
      </p>
      <ul id="pendientes-examen" class="pendientes-examen" />
    </div>

    <div id="bloque-practicar" class="tarjeta-examen" hidden>
      <p class="examen-umbral">
        En sandbox no hay examen: practica las tarjetas de este capítulo sueltas.
      </p>
      <a class="boton-examen" href={rutaPracticarCapitulo(materia, capitulo.id)}>
        Practicar este capítulo
      </a>
    </div>

    <p class="salir"><a href={rutaMateria(materia)}>&larr; Volver</a></p>
  </article>
  </Muro>

  <script
    is:inline
    type="application/json"
    id="datos-relatos"
    set:html={JSON.stringify(capitulo.relatosResumen)}
  />

  <script>
    import { leerEstado } from "../../../lib/estado";
    import { rutaRelato } from "../../../lib/rutas";

    interface RelatoDatos {
      id: string;
      nombre: string;
    }

    const materiaSlug = document.documentElement.dataset.materia ?? "";
    const datosEl = document.getElementById("datos-relatos");
    const relatosCapitulo: RelatoDatos[] = datosEl
      ? JSON.parse(datosEl.textContent ?? "[]")
      : [];
    const estado = leerEstado();

    for (const relato of relatosCapitulo) {
      const fila = document.querySelector(`[data-relato="${relato.id}"]`);
      const el = fila?.querySelector(".estado-relato");
      const leido = estado.leidos.includes(relato.id);
      if (el) el.textContent = leido ? "Leído" : "";
      if (fila instanceof HTMLElement) fila.dataset.leido = String(leido);
    }

    // Examen deshabilitado sin lectura completa (§4.4): visible siempre,
    // nunca oculto — solo se desbloquea cuando TODOS los relatos escritos del
    // capítulo están en `leidos`. Los previstos sin escribir no cuentan: no
    // tienen página que enlazar y nunca podrán estar en `leidos`.
    const pendientes = relatosCapitulo.filter((r) => !estado.leidos.includes(r.id));
    const botonExamen = document.getElementById("boton-examen");
    const listaPendientes = document.getElementById("pendientes-examen");
    if (pendientes.length === 0) {
      botonExamen?.removeAttribute("aria-disabled");
      botonExamen?.removeAttribute("tabindex");
    } else {
      document.getElementById("examen-pendiente-texto")?.removeAttribute("hidden");
      for (const relato of pendientes) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = rutaRelato(materiaSlug, relato.id);
        a.textContent = relato.nombre;
        li.appendChild(a);
        listaPendientes?.appendChild(li);
      }
      botonExamen?.addEventListener("click", (evento) => {
        if (botonExamen.getAttribute("aria-disabled") === "true") evento.preventDefault();
      });
    }

    // Sandbox diferencial (plan de gamificación §5): el examen no existe en
    // sandbox, la acción del capítulo pasa a "Practicar este capítulo". Un
    // solo componente de capítulo con dos modos de render, no dos pantallas
    // — mismo patrón que ya usa album.astro con #indice-sandbox/#album.
    if (estado.modo === "sandbox") {
      document.getElementById("bloque-examen")?.setAttribute("hidden", "");
      document.getElementById("bloque-practicar")?.removeAttribute("hidden");
    }
  </script>
</Base>

<style>
  .cabecera-lista {
    padding: 20px 20px 4px;
  }

  .titulo-lista {
    margin: 0;
    font-size: 26px;
    font-weight: var(--peso-titulo-grande);
    font-family: var(--fuente-titulo);
  }

  .subtitulo-lista {
    margin: 6px 0 0;
    color: var(--color-texto-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .lista-relatos {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .fila-relato[data-leido="true"] {
    opacity: 0.75;
  }

  .enlace-relato {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    color: var(--color-texto);
    text-decoration: none;
    box-sizing: border-box;
  }

  .num-relato {
    flex: 0 0 auto;
    width: 28px;
    font-size: 22px;
    font-weight: 700;
    color: var(--color-acento);
    font-family: var(--fuente-titulo);
  }

  .miniatura-relato {
    flex: 0 0 auto;
    width: 44px;
  }

  .texto-relato {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .titulo-relato {
    font-size: 17px;
    font-weight: 700;
    font-family: var(--fuente-titulo);
  }

  .estado-relato {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .chevron-relato {
    font-size: 20px;
    color: var(--color-texto-muted);
  }

  .fila-relato-prevista {
    display: flex;
    align-items: center;
    padding: 16px 20px 16px 62px;
    border-bottom: 1px solid var(--color-tarjeta-borde);
    opacity: 0.5;
  }

  .tarjeta-info,
  .tarjeta-examen {
    margin: 16px 20px 0;
    padding: 16px;
    border: 1px solid var(--color-tarjeta-borde);
    border-radius: var(--radio);
    background: var(--color-tarjeta-fondo);
  }

  .tarjeta-info {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .info-numero {
    font-size: 22px;
    font-weight: 800;
    font-family: var(--fuente-titulo);
    color: var(--color-acento);
  }

  .info-etiqueta {
    font-size: 14px;
    color: var(--color-texto-muted);
  }

  .examen-umbral {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--color-texto-muted);
  }

  .boton-examen {
    display: block;
    padding: 14px;
    border-radius: var(--radio);
    background: var(--color-acento);
    color: var(--color-acento-contraste);
    font-family: var(--fuente-titulo);
    font-size: 15px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .boton-examen[aria-disabled="true"] {
    background: var(--color-tarjeta-borde);
    color: var(--color-texto-muted);
    cursor: not-allowed;
  }

  .examen-pendiente-texto {
    margin: 10px 0 4px;
    font-size: 13px;
    color: var(--color-texto-muted);
  }

  .pendientes-examen {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pendientes-examen li {
    padding: 4px 0;
  }

  .pendientes-examen a {
    color: var(--color-acento);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .salir {
    padding: 20px;
  }

  .salir a {
    color: var(--color-acento);
    text-decoration: none;
    font-weight: 600;
  }
</style>
