---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { cargarCapitulos } from "../../../lib/capitulos";
import { rutaExamen, rutaMateria, rutaRelato } from "../../../lib/rutas";
import { generarTarjetas } from "../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const capitulos = await cargarCapitulos(m.id);
			return capitulos.map((c) => ({
				params: { materia: m.data.slug, id: c.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const capitulos = await cargarCapitulos(materiaId);
const capitulo = capitulos.find((c) => c.id === id);
if (!capitulo) throw new Error(`Capítulo no encontrado: ${id}`);

const relatosCol = await getCollection("relatos");
const relatosPorId = new Map(relatosCol.map((r) => [r.id, r.data]));
const relatos = capitulo.relatos.map((rid) => ({
	id: rid,
	nombre: relatosPorId.get(rid)?.nombre ?? rid,
}));

const tarjetas = await generarTarjetas(materiaId, capitulo.conjunto);
---

<Base titulo={capitulo.nombre}>
  <article>
    <h1>{capitulo.nombre}</h1>
    <p>{capitulo.resumen}</p>

    <h2>Relatos</h2>
    <ol>
      {
        relatos.map((r) => (
          <li>
            <a href={rutaRelato(materia, r.id)}>{r.nombre}</a>
          </li>
        ))
      }
    </ol>

    <h2>Tarjetas</h2>
    <p>{tarjetas.length} tarjetas en este capítulo.</p>

    <h2>Examen</h2>
    <p>Aprueba con {capitulo.examen.aciertos} de {capitulo.examen.de}.</p>
    <p><a href={rutaExamen(materia, capitulo.id)}>Empezar el examen</a></p>

    <p><a href={rutaMateria(materia)}>&larr; volver</a></p>
  </article>
</Base>
