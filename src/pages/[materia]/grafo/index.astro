  }

  .sin-datos {
    padding: 0 20px;
    color: var(--color-texto-muted);
  }

  .salir {
    padding: 8px 20px 24px;
  }

  .salir a {
    color: var(--color-acento);
    text-decoration: none;
    font-weight: 600;
  }
</style>
