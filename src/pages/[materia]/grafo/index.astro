---
import { getCollection } from "astro:content";
import Casilla from "../../../components/Casilla.astro";
import Base from "../../../layouts/Base.astro";
import { construirGrafo } from "../../../lib/grafo";
import {
	colorDeTipo,
	construirVistaFamilia,
	FAMILIA_PARENTESCO,
} from "../../../lib/grafoCompleto";
import { resolverRetrato } from "../../../lib/retrato";
import { rutaEntidad, rutaMateria } from "../../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({
		params: { materia: m.data.slug },
		props: { materiaId: m.id },
	}));
}

const { materia } = Astro.params;
const { materiaId } = Astro.props;

const grafo = await construirGrafo(materiaId);
const vista = await construirVistaFamilia(grafo);

const retratos = new Map(
	(vista?.nodos ?? []).map((n) => {
		const e = grafo.entidades.get(n.idEntidad);
		return [n.idEntidad, e ? resolverRetrato(grafo, e) : undefined];
	}),
);
const posiciones = new Map(
	[...(vista?.nodos ?? []), ...(vista?.uniones ?? [])].map((n) => [n.id, n]),
);
// Un hub duplicado (§3) mete varias copias en `vista.nodos` — para el
// contador de la cabecera se cuentan entidades reales, no copias.
const totalEntidades = new Set((vista?.nodos ?? []).map((n) => n.idEntidad))
	.size;
---

<Base titulo={`Árbol — ${materia}`} materiaSlug={materia} anchoCompleto>
  <article class="grafo-pagina">
    <header class="cabecera-juego">
      <h1>Árbol genealógico</h1>
      <p class="subtitulo">
        {vista ? `${vista.enlaces.length} relaciones, ${totalEntidades} entidades` : "Sin datos todavía"}
      </p>
    </header>

    {
      FAMILIA_PARENTESCO.tiposCanonicos.length > 0 && (
        <ul class="leyenda">
          {FAMILIA_PARENTESCO.tiposCanonicos.map((tipo) => (
            <li>
              <span class="marca-color" style={`background:${colorDeTipo(FAMILIA_PARENTESCO, tipo)}`} />
              {tipo.replaceAll("_", " ")}
            </li>
          ))}
        </ul>
      )
    }

    {
      vista ? (
        <div class="lienzo-scroll">
          <div class="lienzo" style={`width:${vista.ancho}px; height:${vista.alto}px`}>
            <svg
              class="enlaces"
              width={vista.ancho}
              height={vista.alto}
              viewBox={`0 0 ${vista.ancho} ${vista.alto}`}
            >
              {vista.filas.slice(0, -1).map((y, i) => {
                const mitad = (y + vista.filas[i + 1]) / 2;
                return <line class="fila-divisor" x1={0} y1={mitad} x2={vista.ancho} y2={mitad} />;
              })}
              {vista.enlaces.map((enlace) => {
                const desde = posiciones.get(enlace.desde);
                const hasta = posiciones.get(enlace.hasta);
                if (!desde || !hasta) return null;
                return (
                  <line
                    x1={desde.x}
                    y1={desde.y}
                    x2={hasta.x}
                    y2={hasta.y}
                    stroke={enlace.color}
                    stroke-dasharray={enlace.discontinuo ? "3 3" : undefined}
                  />
                );
              })}
              {vista.uniones.map((u) => (
                <circle class="union" cx={u.x} cy={u.y} r="3.5" />
              ))}
            </svg>
            {vista.nodos.map((n) => (
              <div class="nodo" style={`left:${n.x}px; top:${n.y}px`} data-duplicado={n.duplicado}>
                <a href={rutaEntidad(materia, n.idEntidad)} class="nodo-enlace">
                  <div class="nodo-casilla">
                    <Casilla nombre={n.nombre} tipo={n.tipo} retrato={retratos.get(n.idEntidad)} />
                  </div>
                  <span class="nodo-nombre">{n.nombre}</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="sin-datos">Todavía no hay relaciones de parentesco en el contenido.</p>
      )
    }

    <p class="salir"><a href={rutaMateria(materia)}>&larr; Volver</a></p>
  </article>
</Base>

<script>
  // Arrastrar para desplazar (bloque motor, pedido tras el §3): con 60-70
  // entidades el lienzo es mucho más ancho y alto que la ventana, y las
  // barras de scroll del navegador son incómodas para moverse por un mapa
  // así. Solo ratón — el táctil ya desplaza de forma nativa arrastrando con
  // el dedo, y capturar el puntero ahí competiría con ese gesto en vez de
  // sumarse a él.
  const contenedor = document.querySelector<HTMLElement>(".lienzo-scroll");
  if (contenedor) {
    let arrastrando = false;
    let movido = false;
    let inicioX = 0;
    let inicioY = 0;
    let scrollInicioX = 0;
    let scrollInicioY = 0;

    contenedor.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      arrastrando = true;
      movido = false;
      inicioX = e.clientX;
      inicioY = e.clientY;
      scrollInicioX = contenedor.scrollLeft;
      scrollInicioY = contenedor.scrollTop;
    });

    contenedor.addEventListener("pointermove", (e) => {
      if (!arrastrando) return;
      const dx = e.clientX - inicioX;
      const dy = e.clientY - inicioY;
      // Umbral antes de considerarlo arrastre de verdad: un clic normal
      // tiembla unos píxeles entre pointerdown y pointerup, y sin umbral
      // ese temblor ya bastaría para cancelar la navegación del nodo. La
      // captura del puntero se pide aquí, no en pointerdown: si se captura
      // ya al pulsar, hasta un clic sin mover el ratón queda "capturado" y
      // el evento click se retargeta al contenedor en vez de al enlace
      // bajo el cursor — deja de navegar aunque no haya habido arrastre.
      if (!movido && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) {
        movido = true;
        contenedor.setPointerCapture(e.pointerId);
        contenedor.classList.add("arrastrando");
      }
      if (!movido) return;
      contenedor.scrollLeft = scrollInicioX - dx;
      contenedor.scrollTop = scrollInicioY - dy;
    });

    const terminarArrastre = () => {
      arrastrando = false;
      contenedor.classList.remove("arrastrando");
    };
    contenedor.addEventListener("pointerup", terminarArrastre);
    contenedor.addEventListener("pointercancel", terminarArrastre);

    // Un arrastre real no debe además navegar al enlace del nodo bajo el
    // puntero al soltar — en fase de captura, antes de que el enlace lo vea.
    contenedor.addEventListener(
      "click",
      (e) => {
        if (movido) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  }
</script>

<style>
  .grafo-pagina {
    padding-bottom: 24px;
  }

  .cabecera-juego {
    padding: 12px 20px 0;
  }

  .cabecera-juego h1 {
    margin: 0;
    font-size: 20px;
  }

  .subtitulo {
    margin: 2px 0 0;
    color: var(--color-texto-muted);
    font-size: 14px;
  }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin: 10px 0 0;
    padding: 0 20px;
    list-style: none;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .leyenda li {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .marca-color {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    display: inline-block;
  }

  .lienzo-scroll {
    overflow: auto;
    /* Caja acotada, no la altura de la página: con el árbol completo el
       lienzo suele ser mucho más alto que la ventana, y sin un límite
       aquí no hay "arrastrar para desplazar" posible en vertical — el
       scroll pasaría a ser el de la página, fuera del alcance del script. */
    height: min(78vh, 760px);
    padding: 16px 20px 20px;
    cursor: grab;
    overscroll-behavior: contain;
  }

  .lienzo-scroll.arrastrando {
    cursor: grabbing;
    user-select: none;
  }

  .lienzo {
    position: relative;
    margin: 0 auto;
  }

  .enlaces {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .enlaces line {
    stroke-width: 2;
  }

  .enlaces line.fila-divisor {
    stroke: var(--color-tarjeta-borde);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.5;
  }

  .enlaces circle.union {
    fill: var(--color-fondo-pantalla);
    stroke: var(--color-tarjeta-borde);
    stroke-width: 1.5;
  }

  .nodo {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 60px;
  }

  .nodo-enlace {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-texto);
  }

  .nodo-casilla {
    width: 44px;
  }

  .nodo-nombre {
    font-size: 10px;
    text-align: center;
    line-height: 1.15;
  }

  /* Copia de un hub multi-unión (§3): borde punteado para distinguirla de
     una entidad normal, sin tocar el color de tipo ni el retrato — sigue
     siendo la misma entidad, solo repartida en varias posiciones. En
     `.nodo-casilla` (de este fichero), no en `.casilla` de Casilla.astro:
     el CSS con scope de Astro añade su hash a cada clase del selector, y
     `.casilla` lleva el hash del componente hijo, no el de esta página —
     el selector nunca casaría. */
  .nodo[data-duplicado="true"] .nodo-casilla {
    outline: 2px dashed var(--color-texto-muted);
    outline-offset: 2px;
    border-radius: var(--radio);
  }

  .sin-datos {
    padding: 0 20px;
    color: var(--color-texto-muted);
  }

  .salir {
    padding: 8px 20px 24px;
  }

  .salir a {
    color: var(--color-acento);
    text-decoration: none;
    font-weight: 600;
  }
</style>
