---
import { getCollection } from "astro:content";
import Casilla from "../../../components/Casilla.astro";
import Base from "../../../layouts/Base.astro";
import { construirGrafo } from "../../../lib/grafo";
import {
	colorDeTipo,
	construirVistaFamilia,
	FAMILIAS,
} from "../../../lib/grafoCompleto";
import { resolverRetrato } from "../../../lib/retrato";
import { rutaEntidad, rutaGrafo, rutaGrafoFamilia } from "../../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.flatMap((m) =>
		FAMILIAS.map((f) => ({
			params: { materia: m.data.slug, familia: f.id },
			props: { materiaId: m.id },
		})),
	);
}

const { materia, familia: familiaId } = Astro.params;
const { materiaId } = Astro.props;

const grafo = await construirGrafo(materiaId);
const vista = construirVistaFamilia(grafo, familiaId ?? "");
const familia = FAMILIAS.find((f) => f.id === familiaId);
if (!familia) throw new Error(`Familia de relación desconocida: ${familiaId}`);

const retratos = new Map(
	(vista?.nodos ?? []).map((n) => {
		const e = grafo.entidades.get(n.id);
		return [n.id, e ? resolverRetrato(grafo, e) : undefined];
	}),
);
const posiciones = new Map((vista?.nodos ?? []).map((n) => [n.id, n]));
---

<Base titulo={`Árbol — ${familia.etiqueta}`} materiaSlug={materia}>
  <article class="grafo-pagina">
    <header class="cabecera-juego">
      <h1>Árbol — {familia.etiqueta}</h1>
      <p class="subtitulo">
        {vista ? `${vista.enlaces.length} relaciones, ${vista.nodos.length} entidades` : "Sin datos todavía"}
      </p>
    </header>

    <nav class="tabs-familia" aria-label="Familias de relación">
      {
        FAMILIAS.map((f) => (
          <a href={rutaGrafoFamilia(materia, f.id)} aria-current={f.id === familiaId}>
            {f.etiqueta}
          </a>
        ))
      }
    </nav>

    {
      familia.tiposCanonicos.length > 0 && (
        <ul class="leyenda">
          {familia.tiposCanonicos.map((tipo) => (
            <li>
              <span class="marca-color" style={`background:${colorDeTipo(familia, tipo)}`} />
              {tipo.replaceAll("_", " ")}
            </li>
          ))}
        </ul>
      )
    }

    {
      vista ? (
        <div class="lienzo-scroll">
          <div class="lienzo" style={`width:${vista.ancho}px; height:${vista.alto}px`}>
            <svg
              class="enlaces"
              width={vista.ancho}
              height={vista.alto}
              viewBox={`0 0 ${vista.ancho} ${vista.alto}`}
            >
              {vista.enlaces.map((enlace) => {
                const desde = posiciones.get(enlace.desde);
                const hasta = posiciones.get(enlace.hasta);
                if (!desde || !hasta) return null;
                return (
                  <line
                    x1={desde.x}
                    y1={desde.y}
                    x2={hasta.x}
                    y2={hasta.y}
                    stroke={enlace.color}
                  />
                );
              })}
            </svg>
            {vista.nodos.map((n) => (
              <div class="nodo" style={`left:${n.x}px; top:${n.y}px`}>
                <a href={rutaEntidad(materia, n.id)} class="nodo-enlace">
                  <div class="nodo-casilla">
                    <Casilla nombre={n.nombre} tipo={n.tipo} retrato={retratos.get(n.id)} />
                  </div>
                  <span class="nodo-nombre">{n.nombre}</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="sin-datos">
          Todavía no hay ninguna relación de tipo «{familia.etiqueta.toLowerCase()}» en el
          contenido.
        </p>
      )
    }

    <p class="salir"><a href={rutaGrafo(materia)}>&larr; Todas las familias</a></p>
  </article>
</Base>

<style>
  .grafo-pagina {
    padding-bottom: 24px;
  }

  .cabecera-juego {
    padding: 12px 20px 0;
  }

  .cabecera-juego h1 {
    margin: 0;
    font-size: 20px;
  }

  .subtitulo {
    margin: 2px 0 0;
    color: var(--color-texto-muted);
    font-size: 14px;
  }

  .tabs-familia {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 20px 0;
  }

  .tabs-familia a {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--color-tarjeta-borde);
    color: var(--color-texto);
    font-size: 13px;
    text-decoration: none;
  }

  .tabs-familia a[aria-current="true"] {
    background: var(--color-acento);
    border-color: var(--color-acento);
    color: var(--color-acento-contraste);
    font-weight: 700;
  }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin: 10px 0 0;
    padding: 0 20px;
    list-style: none;
    font-size: 12px;
    color: var(--color-texto-muted);
  }

  .leyenda li {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .marca-color {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    display: inline-block;
  }

  .lienzo-scroll {
    overflow-x: auto;
    padding: 16px 20px 20px;
  }

  .lienzo {
    position: relative;
    margin: 0 auto;
  }

  .enlaces {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .enlaces line {
    stroke-width: 2;
  }

  .nodo {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 60px;
  }

  .nodo-enlace {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-texto);
  }

  .nodo-casilla {
    width: 44px;
  }

  .nodo-nombre {
    font-size: 10px;
    text-align: center;
    line-height: 1.15;
  }

  .sin-datos {
    padding: 0 20px;
    color: var(--color-texto-muted);
  }

  .salir {
    padding: 8px 20px 0;
  }

  .salir a {
    color: var(--color-acento);
    text-decoration: none;
    font-weight: 600;
  }
</style>
