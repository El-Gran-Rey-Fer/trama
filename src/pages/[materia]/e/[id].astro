---
import { getCollection } from "astro:content";
import FichaEntidad from "../../../components/FichaEntidad.astro";
import Base from "../../../layouts/Base.astro";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const entidades = await getCollection("entidades");
	return materias.flatMap((m) =>
		entidades.map((e) => ({
			params: { materia: m.data.slug, id: e.id },
			props: { materiaId: m.id },
		})),
	);
}

const { id } = Astro.params;
const { materiaId } = Astro.props;
const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

const nodos = new Map(
	[...grafo.entidades.values()].map((e) => [
		e.id,
		{ nombre: e.nombre, kind: e.kind },
	]),
);
---

<Base titulo={entidad.nombre}>
  <FichaEntidad entidad={entidad} materiaSlug={grafo.slug} nodos={nodos} />
</Base>
