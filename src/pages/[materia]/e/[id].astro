---
import { getCollection } from "astro:content";
import FichaEntidad from "../../../components/FichaEntidad.astro";
import Muro from "../../../components/Muro.astro";
import Base from "../../../layouts/Base.astro";
import {
	capitulosQueDesbloquean,
	cargarCapitulos,
	construirCadena,
} from "../../../lib/capitulos";
import { entidadesDeMateria } from "../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";
import { resolverRetrato } from "../../../lib/retrato";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const entidades = await entidadesDeMateria(m.id);
			return entidades.map((e) => ({
				params: { materia: m.data.slug, id: e.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { id, materia } = Astro.params;
const { materiaId } = Astro.props;
const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

const nodos = new Map(
	[...grafo.entidades.values()].map((e) => [
		e.id,
		{ nombre: e.nombre, kind: e.kind },
	]),
);
const retrato = resolverRetrato(grafo, entidad);

// Muro de aventura (bloque W): esta ficha la desbloquea cualquier capítulo
// cuyo conjunto la contenga. `destinos` cubre además cada id que la propia
// ficha enlaza (relaciones + "aparece en"), para que FichaEntidad pueda
// convertir en silueta los que no sean accesibles — sin enviarle el
// `conjunto` completo de los capítulos, solo los ids que le hacen falta a
// ESTA ficha.
const capitulos = await cargarCapitulos(materiaId);
const cadena = construirCadena(capitulos);
const desbloqueadoPor = capitulosQueDesbloquean(capitulos, id, "entidad");
const idsDestino = new Set(entidad.relaciones.map((r) => r.destino));
const destinos: Record<string, string[]> = {};
for (const destinoId of idsDestino) {
	destinos[destinoId] = capitulosQueDesbloquean(
		capitulos,
		destinoId,
		nodos.get(destinoId)?.kind === "relato" ? "relato" : "entidad",
	);
}
---

<Base titulo={entidad.nombre} materiaSlug={materia}>
  <Muro cadena={cadena} capitulosQueDesbloquean={desbloqueadoPor} materiaSlug={materia}>
    <FichaEntidad
      entidad={entidad}
      materiaSlug={grafo.slug}
      nodos={nodos}
      retrato={retrato}
      destinos={destinos}
      cadena={cadena}
    />
  </Muro>
</Base>
