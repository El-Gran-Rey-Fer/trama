---
import { getCollection } from "astro:content";
import FichaEntidad from "../../../components/FichaEntidad.astro";
import Base from "../../../layouts/Base.astro";
import { entidadesDeMateria } from "../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../lib/grafo";
import { resolverRetrato } from "../../../lib/retrato";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const entidades = await entidadesDeMateria(m.id);
			return entidades.map((e) => ({
				params: { materia: m.data.slug, id: e.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { id, materia } = Astro.params;
const { materiaId } = Astro.props;
const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

const nodos = new Map(
	[...grafo.entidades.values()].map((e) => [
		e.id,
		{ nombre: e.nombre, kind: e.kind },
	]),
);
const retrato = resolverRetrato(grafo, entidad);
---

<Base titulo={entidad.nombre} materiaSlug={materia}>
  <FichaEntidad entidad={entidad} materiaSlug={grafo.slug} nodos={nodos} retrato={retrato} />
</Base>
