---
import { getCollection } from "astro:content";
import ArbolGenealogico from "../../../../components/ArbolGenealogico.astro";
import Base from "../../../../layouts/Base.astro";
import { entidadesDeMateria } from "../../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../../lib/grafo";
import { construirVistaFamilia } from "../../../../lib/grafoCompleto";
import { resolverRetrato } from "../../../../lib/retrato";
import { rutaEntidad } from "../../../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const entidades = await entidadesDeMateria(m.id);
			return entidades.map((e) => ({
				params: { materia: m.data.slug, id: e.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

// Vista primero, calculada en build y servida sin JavaScript en cliente
// (plan de imágenes y álbum, paso A7). El layout ya sale en píxeles listos
// para posicionar; no hace falta tocarlo en el navegador. Misma ventana de
// ego (±2 generaciones) que antes calculaba arbol.ts con d3-hierarchy,
// pero con el motor único de grafoCompleto.ts (fusiona parejas en nodos de
// unión en vez de duplicar antepasados compartidos).
const arbol = construirVistaFamilia(grafo, { centro: id, profundidad: 2 });

const retratos = new Map(
	(arbol?.nodos ?? []).map((n) => {
		const e = obtenerEntidad(grafo, n.id);
		return [n.id, e ? resolverRetrato(grafo, e) : undefined];
	}),
);
---

<Base titulo={`Árbol — ${entidad.nombre}`} materiaSlug={materia}>
  <article class="arbol-pagina">
    <header class="cabecera-juego">
      <h1>Árbol genealógico</h1>
      <p class="subtitulo">{entidad.nombre}</p>
    </header>

    {
      arbol ? (
        <div class="arbol-contenedor">
          <ArbolGenealogico arbol={arbol} retratos={retratos} materiaSlug={materia} idRaiz={id} />
        </div>
      ) : (
        <p class="sin-arbol">
          No se conocen antepasados ni descendientes de {entidad.nombre} en el grafo todavía.
        </p>
      )
    }

    <p class="salir"><a href={rutaEntidad(materia, id)}>&larr; Volver a la ficha</a></p>
  </article>
</Base>

<style>
  .arbol-pagina {
    padding-bottom: 24px;
  }

  .cabecera-juego {
    padding: 12px 20px;
  }

  .cabecera-juego h1 {
    margin: 0;
    font-size: 20px;
  }

  .subtitulo {
    margin: 2px 0 0;
    color: var(--color-texto-muted);
    font-size: 14px;
  }

  .arbol-contenedor {
    padding: 12px 20px 20px;
  }

  .sin-arbol {
    padding: 0 20px;
    color: var(--color-texto-muted);
  }

  .salir {
    padding: 8px 20px 0;
  }
</style>
