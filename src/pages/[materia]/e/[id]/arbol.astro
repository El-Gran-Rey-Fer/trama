---
import { getCollection } from "astro:content";
import Casilla from "../../../../components/Casilla.astro";
import Base from "../../../../layouts/Base.astro";
import { entidadesDeMateria } from "../../../../lib/contenidoPorMateria";
import { construirGrafo, obtenerEntidad } from "../../../../lib/grafo";
import { construirVistaFamilia } from "../../../../lib/grafoCompleto";
import { resolverRetrato } from "../../../../lib/retrato";
import { rutaEntidad } from "../../../../lib/rutas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const porMateria = await Promise.all(
		materias.map(async (m) => {
			const entidades = await entidadesDeMateria(m.id);
			return entidades.map((e) => ({
				params: { materia: m.data.slug, id: e.id },
				props: { materiaId: m.id },
			}));
		}),
	);
	return porMateria.flat();
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

// Vista primero, calculada en build y servida sin JavaScript en cliente
// (plan de imágenes y álbum, paso A7). El layout ya sale en píxeles listos
// para posicionar; no hace falta tocarlo en el navegador. Misma ventana de
// ego (±2 generaciones) que antes calculaba arbol.ts con d3-hierarchy,
// pero con el motor único de grafoCompleto.ts (fusiona parejas en nodos de
// unión en vez de duplicar antepasados compartidos).
const arbol = construirVistaFamilia(grafo, { centro: id, profundidad: 2 });

const retratos = new Map(
	(arbol?.nodos ?? []).map((n) => {
		const e = obtenerEntidad(grafo, n.id);
		return [n.id, e ? resolverRetrato(grafo, e) : undefined];
	}),
);
const posiciones = new Map(
	[...(arbol?.nodos ?? []), ...(arbol?.uniones ?? [])].map((n) => [n.id, n]),
);
---

<Base titulo={`Árbol — ${entidad.nombre}`} materiaSlug={materia}>
  <article class="arbol-pagina">
    <header class="cabecera-juego">
      <h1>Árbol genealógico</h1>
      <p class="subtitulo">{entidad.nombre}</p>
    </header>

    {
      arbol ? (
        <div class="lienzo-scroll">
          <div class="lienzo" style={`width:${arbol.ancho}px; height:${arbol.alto}px`}>
            <svg
              class="enlaces"
              width={arbol.ancho}
              height={arbol.alto}
              viewBox={`0 0 ${arbol.ancho} ${arbol.alto}`}
            >
              {arbol.filas.slice(0, -1).map((y, i) => {
                const mitad = (y + arbol.filas[i + 1]) / 2;
                return <line class="fila-divisor" x1={0} y1={mitad} x2={arbol.ancho} y2={mitad} />;
              })}
              {arbol.enlaces.map((enlace) => {
                const desde = posiciones.get(enlace.desde);
                const hasta = posiciones.get(enlace.hasta);
                if (!desde || !hasta) return null;
                return (
                  <line x1={desde.x} y1={desde.y} x2={hasta.x} y2={hasta.y} stroke={enlace.color} />
                );
              })}
              {arbol.uniones.map((u) => (
                <circle class="union" cx={u.x} cy={u.y} r="3.5" />
              ))}
            </svg>
            {arbol.nodos.map((n) => (
              <div class="nodo" style={`left:${n.x}px; top:${n.y}px`} data-raiz={n.id === id}>
                <a href={rutaEntidad(materia, n.id)} class="nodo-enlace">
                  <div class="nodo-casilla">
                    <Casilla nombre={n.nombre} tipo={n.tipo} retrato={retratos.get(n.id)} />
                  </div>
                  <span class="nodo-nombre">{n.nombre}</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="sin-arbol">
          No se conocen antepasados ni descendientes de {entidad.nombre} en el grafo todavía.
        </p>
      )
    }

    <p class="salir"><a href={rutaEntidad(materia, id)}>&larr; Volver a la ficha</a></p>
  </article>
</Base>

<style>
  .arbol-pagina {
    padding-bottom: 24px;
  }

  .cabecera-juego {
    padding: 12px 20px;
  }

  .cabecera-juego h1 {
    margin: 0;
    font-size: 20px;
  }

  .subtitulo {
    margin: 2px 0 0;
    color: var(--color-texto-muted);
    font-size: 14px;
  }

  .lienzo-scroll {
    overflow-x: auto;
    padding: 12px 20px 20px;
  }

  .lienzo {
    position: relative;
    margin: 0 auto;
  }

  .enlaces {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .enlaces line {
    stroke-width: 2;
  }

  .enlaces line.fila-divisor {
    stroke: var(--color-tarjeta-borde);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.5;
  }

  .enlaces circle.union {
    fill: var(--color-fondo-pantalla);
    stroke: var(--color-tarjeta-borde);
    stroke-width: 1.5;
  }

  .nodo {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 64px;
  }

  .nodo-enlace {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-texto);
  }

  .nodo-casilla {
    width: 64px;
  }

  .nodo[data-raiz="true"] .nodo-casilla .casilla {
    outline: 2px solid var(--color-acento);
    outline-offset: 2px;
  }

  .nodo-nombre {
    font-size: 11px;
    text-align: center;
    line-height: 1.2;
  }

  .sin-arbol {
    padding: 0 20px;
    color: var(--color-texto-muted);
  }

  .salir {
    padding: 8px 20px 0;
  }
</style>
