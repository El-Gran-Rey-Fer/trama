---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import { construirGrafo, obtenerEntidad } from "../../../../lib/grafo";
import { rutaEntidad } from "../../../../lib/rutas";
import { generarTarjetas } from "../../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const entidades = await getCollection("entidades");
	return materias.flatMap((m) =>
		entidades.map((e) => ({
			params: { materia: m.data.slug, id: e.id },
			props: { materiaId: m.id },
		})),
	);
}

const { materia, id } = Astro.params;
const { materiaId } = Astro.props;

const grafo = await construirGrafo(materiaId);
const entidad = obtenerEntidad(grafo, id);
if (!entidad) throw new Error(`Entidad no encontrada: ${materiaId}/${id}`);

// El examen de personaje incluye también las relaciones que conectan a la
// entidad con otras (decisión del usuario, A4): el conjunto son sus vecinos
// directos, no solo ella. `generarTarjetas` exige que AMBOS extremos de una
// arista estén en `soloIds`, así que hace falta el ego-network a
// profundidad 1, no solo el propio id.
const soloIds = new Set<string>([
	id,
	...entidad.relaciones.map((r) => r.destino),
]);
const tarjetas = await generarTarjetas(materiaId, soloIds);
const preguntas = tarjetas.filter(
	(t) => !t.conjunto && t.distractores.length > 0,
);

// Umbral propio, no el de un capítulo (que crecería sin límite según se
// añadan relaciones y atributos): una tanda fija de como mucho 15, con el
// mismo criterio de 80% que ya usan los capítulos.
const UMBRAL = { aciertos: 12, de: 15 };
---

<Base titulo={`Examen — ${entidad.nombre}`} materiaSlug={materia}>
  <article class="examen">
    <header class="cabecera-juego">
      <div>
        <h1>Examen: {entidad.nombre}</h1>
      </div>
      <p id="progreso"></p>
    </header>

    <div id="tablero"></div>

    <p id="sin-preguntas" hidden>
      Todavía no hay suficientes tarjetas evaluables sobre {entidad.nombre}
      para un examen. Vuelve cuando tenga más contenido.
    </p>

    <p class="salir"><a href={rutaEntidad(materia, id)}>&larr; Volver a la ficha</a></p>
  </article>

  <script
    is:inline
    type="application/json"
    id="datos-examen"
    set:html={JSON.stringify({
      preguntas,
      umbral: UMBRAL,
      entidadId: id,
      nombre: entidad.nombre,
      materiaSlug: materia,
    })}
  />

  <script>
    import { iniciarExamenOpcionMultiple } from "../../../../lib/examenCliente";
    import { guardarEstado, leerEstado } from "../../../../lib/estado";
    import { rutaEntidad } from "../../../../lib/rutas";
    import type { Tarjeta } from "../../../../lib/tarjetas";

    interface Datos {
      preguntas: Tarjeta[];
      umbral: { aciertos: number; de: number };
      entidadId: string;
      nombre: string;
      materiaSlug: string;
    }

    const datosEl = document.getElementById("datos-examen");
    const datos = datosEl
      ? (JSON.parse(datosEl.textContent ?? "{}") as Datos)
      : null;

    const tablero = document.getElementById("tablero");
    const elProgreso = document.getElementById("progreso");
    const elSinPreguntas = document.getElementById("sin-preguntas");

    function mostrarResultado(
      resultado: { aciertos: number; total: number; necesarios: number; superado: boolean; falladas: Tarjeta[] },
      reintentar: () => void,
    ) {
      if (!tablero || !datos) return;
      tablero.innerHTML = "";

      const resumen = document.createElement("p");
      resumen.className = "resultado";
      resumen.textContent = `${resultado.aciertos} / ${resultado.total} correctas.`;
      tablero.appendChild(resumen);

      if (resultado.superado) {
        const estado = leerEstado();
        if (!estado.dominados.includes(datos.entidadId)) {
          estado.dominados.push(datos.entidadId);
          guardarEstado(estado);
        }

        const exito = document.createElement("p");
        exito.className = "exito";
        exito.textContent = `¡${datos.nombre}, dominado!`;
        tablero.appendChild(exito);

        const enlace = document.createElement("a");
        enlace.className = "boton-siguiente";
        enlace.href = rutaEntidad(datos.materiaSlug, datos.entidadId);
        enlace.textContent = "Volver a la ficha";
        tablero.appendChild(enlace);
      } else {
        const aviso = document.createElement("p");
        aviso.textContent = `No llegaste al umbral (${resultado.necesarios}). Repasa esto antes de reintentar:`;
        tablero.appendChild(aviso);

        const listaFalladas = document.createElement("ul");
        listaFalladas.className = "lista-falladas";
        for (const f of resultado.falladas) {
          const item = document.createElement("li");
          item.textContent = `${f.pregunta} → ${f.respuesta}`;
          listaFalladas.appendChild(item);
        }
        tablero.appendChild(listaFalladas);

        const reintentarBoton = document.createElement("button");
        reintentarBoton.type = "button";
        reintentarBoton.className = "boton-siguiente";
        reintentarBoton.textContent = "Reintentar";
        reintentarBoton.addEventListener("click", reintentar);
        tablero.appendChild(reintentarBoton);
      }
    }

    if (datos && tablero) {
      iniciarExamenOpcionMultiple({
        tablero,
        elProgreso,
        elSinPreguntas,
        preguntas: datos.preguntas,
        umbral: datos.umbral,
        maxPreguntas: 15,
        onResultado: mostrarResultado,
      });
    }
  </script>

  <style>
    .cabecera-juego {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 12px 20px;
    }

    .texto-pregunta {
      padding: 0 20px;
      font-size: 18px;
      font-weight: 600;
    }

    .opciones {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 12px 20px;
    }

    .opcion {
      padding: 14px;
      border: 1px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente);
      font-size: 15px;
      text-align: left;
      cursor: pointer;
    }

    .opcion.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 15%, var(--color-tarjeta-fondo));
    }

    .opcion.fallo {
      border-color: var(--color-fallo);
    }

    .resultado {
      padding: 0 20px;
      font-size: 20px;
      font-weight: 700;
    }

    .exito {
      padding: 0 20px;
      color: var(--color-acierto);
      font-weight: 700;
    }

    .lista-falladas {
      padding: 0 20px 0 40px;
      color: var(--color-texto-muted);
      font-size: 14px;
    }

    .boton-siguiente {
      display: inline-block;
      margin: 12px 20px;
      padding: 14px 20px;
      border: none;
      border-radius: var(--radio);
      background: var(--color-acento);
      color: var(--color-acento-contraste);
      font-family: var(--fuente);
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    .salir {
      padding: 20px;
    }
  </style>
</Base>
