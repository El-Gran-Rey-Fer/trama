---
import { getCollection, getEntry } from "astro:content";
import ParticipantesRelato from "../../components/ParticipantesRelato.astro";
import Base from "../../layouts/Base.astro";
import { cargarCapitulos } from "../../lib/capitulos";
import { conjuntoDeRelato } from "../../lib/desbloqueo";
import { construirGrafo } from "../../lib/grafo";
import { resolverRetrato } from "../../lib/retrato";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	return materias.map((m) => ({
		params: { materia: m.data.slug },
		props: { materiaId: m.id },
	}));
}

const { materia } = Astro.params;
const { materiaId } = Astro.props;
const materiaEntry = await getEntry("materias", materiaId);
const capitulos = await cargarCapitulos(materiaId);

const relatos = await getCollection("relatos");
const relatoConjuntos = Object.fromEntries(
	relatos.map((r) => [r.id, conjuntoDeRelato(r.data)]),
);

const grafo = await construirGrafo(materiaId);
// Las obras son entidades del grafo (`kind: "entidad"`) igual que un
// personaje, pero no son coleccionables: decoran a otras entidades y a los
// mitos, no se "encuentran" ni se "dominan". Sin este filtro caerían como
// casilla huérfana (sin retrato propio, solo su inicial) — decisión
// explícita: fuera del álbum y del índice sandbox.
const entidades = [...grafo.entidades.values()].filter(
	(e) => e.kind === "entidad" && e.tipo !== "obra",
);

function datosParticipante(e: (typeof entidades)[number]) {
	return {
		id: e.id,
		nombre: e.nombre,
		tipo: e.tipo,
		retrato: resolverRetrato(grafo, e),
	};
}

// Agrupado por `tipo` (orden del registro en materia.yaml, no alfabético —
// es el orden en que ya se declaran ahí), alfabético dentro de cada tipo.
// Mismo agrupado en los dos modos — una entidad puede estar en varios
// capítulos (participa en varios relatos), así que agrupar por capítulo le
// daba cromos duplicados o un reparto arbitrario; por tipo cada entidad cae
// en un solo grupo. Sin `era`: las entidades no la llevan todavía (se
// añadirá cuando el timeline lo pida, decisión ya cerrada); agrupar por era
// se deja para cuando ese campo exista.
const ordenTipos = materiaEntry?.data.tipos ?? [];
const tiposPresentes = [...new Set(entidades.map((e) => e.tipo))];
tiposPresentes.sort((a, b) => {
	const ia = ordenTipos.indexOf(a);
	const ib = ordenTipos.indexOf(b);
	if (ia === -1 && ib === -1) return a.localeCompare(b, "es");
	if (ia === -1) return 1;
	if (ib === -1) return -1;
	return ia - ib;
});
const gruposPorTipo = tiposPresentes.map((tipo) => ({
	tipo,
	entidades: entidades
		.filter((e) => e.tipo === tipo)
		.sort((a, b) => a.nombre.localeCompare(b.nombre, "es"))
		.map(datosParticipante),
}));

const niveles = materiaEntry?.data.niveles ?? [];
const totalCapitulos = capitulos.length;
const totalEntidades = entidades.length;
const nombreMateria = materiaEntry?.data.nombre ?? materia;
---

<Base titulo={`Álbum — ${nombreMateria}`} materiaSlug={materia}>
  <section id="indice-sandbox" hidden>
    <div class="cabecera-lista">
      <h1 class="titulo-lista">Índice</h1>
    </div>
    {
      gruposPorTipo.map((g) => (
        <div class="grupo-album">
          <h3 class="etiqueta-grupo-album">{g.tipo}</h3>
          <ParticipantesRelato participantes={g.entidades} materiaSlug={materia} />
        </div>
      ))
    }
  </section>

  <section id="album" class="seccion-album">
    <div class="cabecera-lista">
      <h1 class="titulo-lista">Álbum</h1>
      <p id="nivel-cosmetico" class="subtitulo-lista"></p>
    </div>
    {
      gruposPorTipo.map((g) => (
        <div class="grupo-album">
          <h3 class="etiqueta-grupo-album">{g.tipo}</h3>
          <ParticipantesRelato participantes={g.entidades} materiaSlug={materia} />
        </div>
      ))
    }
  </section>

  <script
    is:inline
    type="application/json"
    id="datos-album"
    set:html={JSON.stringify({
      entidadIds: entidades.map((e) => e.id),
      relatoConjuntos,
      niveles,
      totalCapitulos,
      totalEntidades,
    })}
  />

  <script>
    import {
      calcularEstadosCasillas,
      calcularNivel,
      leerEstado,
      type NivelCosmetico,
    } from "../../lib/estado";

    const datosAlbumEl = document.getElementById("datos-album");
    const datosAlbum = datosAlbumEl
      ? (JSON.parse(datosAlbumEl.textContent ?? "{}") as {
          entidadIds: string[];
          relatoConjuntos: Record<string, string[]>;
          niveles: NivelCosmetico[];
          totalCapitulos: number;
          totalEntidades: number;
        })
      : null;

    const estadoActual = leerEstado();
    const elSandbox = document.getElementById("indice-sandbox");
    const elAlbum = document.getElementById("album");
    if (estadoActual.modo === "sandbox") {
      elSandbox?.removeAttribute("hidden");
      elAlbum?.setAttribute("hidden", "");
    } else {
      elSandbox?.setAttribute("hidden", "");
      elAlbum?.removeAttribute("hidden");
    }

    if (datosAlbum) {
      const estadosCasillas = calcularEstadosCasillas(
        datosAlbum.entidadIds,
        datosAlbum.relatoConjuntos,
        estadoActual,
      );
      for (const [id, estado] of Object.entries(estadosCasillas)) {
        const li = document.querySelector(`#album [data-entidad-id="${id}"]`);
        const casilla = li?.querySelector<HTMLElement>(".casilla");
        if (casilla) casilla.dataset.estado = estado;
        if (estado === "sin-encontrar") {
          const nombre = li?.querySelector(".participante-nombre");
          if (nombre) nombre.textContent = "";
        }
      }

      const nivel = calcularNivel(
        datosAlbum.niveles,
        datosAlbum.totalEntidades,
        datosAlbum.totalCapitulos,
        estadoActual,
      );
      const elNivel = document.getElementById("nivel-cosmetico");
      if (elNivel && nivel) elNivel.textContent = `Nivel: ${nivel.nombre}`;
    }
  </script>
</Base>

<style>
  .cabecera-lista {
    padding: 20px 20px 4px;
  }

  .titulo-lista {
    margin: 0;
    font-size: 26px;
    font-weight: var(--peso-titulo-grande);
    font-family: var(--fuente-titulo);
    text-transform: capitalize;
  }

  .subtitulo-lista {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--color-texto-muted);
  }

  .grupo-album {
    margin-bottom: 4px;
  }

  .etiqueta-grupo-album {
    margin: 18px 20px 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-acento);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--fuente-titulo);
  }
</style>
