---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { conjuntoDeRelato } from "../../../lib/desbloqueo";
import { construirGrafo } from "../../../lib/grafo";
import { generarRondasIdentificar } from "../../../lib/identificar";
import { generarRondasArbol } from "../../../lib/juegoArbol";
import { generarPertenencia } from "../../../lib/pertenencia";
import { rutaJugarMenu } from "../../../lib/rutas";
import { generarTarjetas, type Tarjeta } from "../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const juegos = [
		"emparejar",
		"ordenar",
		"pertenencia",
		"completar-arbol",
		"identificar",
	];
	return materias.flatMap((m) =>
		juegos.map((juego) => ({
			params: { materia: m.data.slug, juego },
			props: { materiaId: m.id },
		})),
	);
}

const { materia, juego } = Astro.params;
const { materiaId } = Astro.props;
// El árbol genealógico (completar-arbol) todavía no lleva el rediseño del
// handoff "Juegos y examen": conserva su cabecera propia (Salir / Volver a
// Practicar) mientras el resto ya usa Reiniciar + panel "Jugar de nuevo".
const esArbolCompletar = juego === "completar-arbol";

const grafo = await construirGrafo(materiaId);
const tarjetas = await generarTarjetas(materiaId);
const pertenencia = await generarPertenencia(materiaId);
const rondasArbol = await generarRondasArbol(materiaId);
const rondasIdentificar = await generarRondasIdentificar(materiaId);
const relatos = await getCollection("relatos");
const relatoConjuntos = Object.fromEntries(
	relatos.map((r) => [r.id, conjuntoDeRelato(r.data)]),
);

// Emparejar (rediseño, proyecto Trama de Claude Design): la mitad
// "respuesta" de cada pieza lleva un borde superior del color de tipo de la
// entidad respondida (tokens.css --color-tipo-*), igual que Casilla.astro.
// `ids[1]` es esa entidad en toda tarjeta de relación (directa o inversa: ver
// generarTarjetas), salvo epíteto, donde la respuesta es la propia entidad en
// `ids[0]`. Las de atributo no tienen entidad de respuesta: sin color, caen
// al borde neutro en el cliente.
function tipoDeRespuesta(t: Tarjeta): string | undefined {
	if (t.conjunto) return undefined;
	const idRespuesta = t.tipoRelacion === "epiteto" ? t.ids[0] : t.ids[1];
	return idRespuesta ? grafo.entidades.get(idRespuesta)?.tipo : undefined;
}
const tarjetasConTipo = tarjetas.map((t) => ({
	...t,
	tipoRespuesta: tipoDeRespuesta(t),
}));

// Ordenar (paso 8): la era con más relatos, en su `orden` real. Los datos ya
// existen (`era` + `orden`); no hace falta tocar el esquema.
const materiaEntry = await getEntry("materias", materiaId);
const eras = materiaEntry?.data.eras ?? [];
const porEra = new Map<
	string,
	{ id: string; nombre: string; orden: number }[]
>();
for (const r of relatos) {
	if (!r.data.era || r.data.orden === undefined) continue;
	const lista = porEra.get(r.data.era) ?? [];
	lista.push({ id: r.id, nombre: r.data.nombre, orden: r.data.orden });
	porEra.set(r.data.era, lista);
}
let relatosEra: { id: string; nombre: string; orden: number }[] = [];
let nombreEraOrdenar = "";
for (const era of eras) {
	const lista = porEra.get(era.id);
	if (lista && lista.length > relatosEra.length) {
		relatosEra = lista;
		nombreEraOrdenar = era.nombre;
	}
}
relatosEra.sort((a, b) => a.orden - b.orden);

const TITULOS: Record<string, string> = {
	emparejar: "Emparejar",
	ordenar: "Ordenar",
	pertenencia: "Pertenencia",
	"completar-arbol": "Completar el árbol",
	identificar: "Identificar",
};
const titulo = TITULOS[juego ?? ""] ?? juego;
---

<Base titulo={`${titulo} — ${materia}`} materiaSlug={materia}>
  <article class="juego">
    <header class="cabecera-juego">
      {esArbolCompletar ? (
        <a class="salir" href={rutaJugarMenu(materia)}>&lsaquo; Salir</a>
      ) : (
        <button type="button" id="reiniciar" class="reiniciar">↻ Reiniciar</button>
      )}
      <div class="titulo-wrap">
        <h1>{titulo}</h1>
        {juego === "ordenar" && nombreEraOrdenar && <p class="subtitulo">{nombreEraOrdenar}</p>}
      </div>
      <p id="progreso" class="progreso"></p>
    </header>

    <div id="tablero" data-juego={juego}></div>

    <div id="panel-completado" class="panel-completado" hidden>
      <p id="mensaje"></p>
      {esArbolCompletar ? (
        <a id="volver-practicar" class="volver-practicar" href={rutaJugarMenu(materia)}>
          Volver a Practicar
        </a>
      ) : (
        <button type="button" id="jugar-de-nuevo" class="jugar-de-nuevo">Jugar de nuevo</button>
      )}
    </div>

    <p id="sin-tarjetas" hidden>
      Todavía no hay tarjetas suficientes para jugar. Lee algún relato más, o
      cambia a modo sandbox.
    </p>
  </article>

  <script
    is:inline
    type="application/json"
    id="datos-juego"
    set:html={JSON.stringify({ tarjetasConTipo, pertenencia, rondasArbol, rondasIdentificar, relatoConjuntos, relatosEra })}
  />

  <script>
    import { tarjetasDisponibles } from "../../../lib/disponibilidad";
    import { leerEstado } from "../../../lib/estado";
    import type { RondaIdentificar } from "../../../lib/identificar";
    import type { RondaArbol } from "../../../lib/juegoArbol";
    import type { TarjetaPertenencia } from "../../../lib/pertenencia";
    import { rutaActivo } from "../../../lib/rutas";
    import type { Tarjeta } from "../../../lib/tarjetas";

    interface TarjetaConTipo extends Tarjeta {
      tipoRespuesta?: string;
    }

    interface RelatoEra {
      id: string;
      nombre: string;
      orden: number;
    }

    const datosEl = document.getElementById("datos-juego");
    const {
      tarjetasConTipo,
      pertenencia,
      rondasArbol,
      rondasIdentificar,
      relatoConjuntos,
      relatosEra,
    } = datosEl
      ? (JSON.parse(datosEl.textContent ?? "{}") as {
          tarjetasConTipo: TarjetaConTipo[];
          pertenencia: TarjetaPertenencia[];
          rondasArbol: RondaArbol[];
          rondasIdentificar: RondaIdentificar[];
          relatoConjuntos: Record<string, string[]>;
          relatosEra: RelatoEra[];
        })
      : {
          tarjetasConTipo: [] as TarjetaConTipo[],
          pertenencia: [] as TarjetaPertenencia[],
          rondasArbol: [] as RondaArbol[],
          rondasIdentificar: [] as RondaIdentificar[],
          relatoConjuntos: {},
          relatosEra: [] as RelatoEra[],
        };

    const tablero = document.getElementById("tablero");
    const elProgreso = document.getElementById("progreso");
    const elMensaje = document.getElementById("mensaje");
    const elPanelCompletado = document.getElementById("panel-completado");
    const elSinTarjetas = document.getElementById("sin-tarjetas");

    function completar(texto: string) {
      if (elMensaje) elMensaje.textContent = texto;
      elPanelCompletado?.removeAttribute("hidden");
    }

    function barajar<T>(arr: T[]): T[] {
      const copia = [...arr];
      for (let i = copia.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copia[i], copia[j]] = [copia[j], copia[i]];
      }
      return copia;
    }

    // Copia local de retrato.ts#calcularAspectRatio: ese módulo importa
    // grafo.ts, que trae "astro:content" (server-only) — inaceptable en un
    // script de cliente. La cuenta es tres líneas, no vale la pena partir el
    // módulo solo por esto.
    function calcularAspectRatio(
      imagen: { ancho?: number; alto?: number },
      recorte: [number, number],
    ): number | undefined {
      if (!imagen.ancho || !imagen.alto) return undefined;
      const ratio = ((recorte[0] / 100) * imagen.ancho) / ((recorte[1] / 100) * imagen.alto);
      return Math.min(Math.max(ratio, 0.5), 3);
    }

    // Astro solo marca con `data-astro-cid-*` los elementos que escribe él
    // mismo al renderizar la plantilla; a un nodo creado aquí en cliente con
    // document.createElement esa marca no le llega, y el <style> con scope
    // de este componente (que exige esa marca en cada selector) no le
    // aplica nada — se queda con el estilo por defecto del navegador. `crear`
    // copia la marca de #tablero (que sí la lleva) a cada nodo que crea el
    // juego, para que las clases de más abajo sí tengan efecto.
    const ATRIBUTO_CID = tablero
      ? [...tablero.attributes].find((a) => a.name.startsWith("data-astro-cid-"))?.name
      : undefined;

    function crear<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
    ): HTMLElementTagNameMap[K] {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (ATRIBUTO_CID) el.setAttribute(ATRIBUTO_CID, "");
      return el;
    }

    function crearPiezaEmparejar(
      texto: string,
      rol: "pregunta" | "respuesta",
      par: string,
      tipoRespuesta?: string,
    ) {
      const boton = crear("button", "pieza");
      boton.type = "button";
      boton.dataset.par = par;

      const eyebrow = crear("span", "eyebrow-pieza");
      eyebrow.textContent = rol === "pregunta" ? "PREGUNTA" : "RESPUESTA";

      const cuerpo = crear("span", "texto-pieza");
      cuerpo.textContent = texto;

      boton.append(eyebrow, cuerpo);
      if (rol === "respuesta" && tipoRespuesta) {
        boton.style.borderTopColor = `var(--color-tipo-${tipoRespuesta})`;
      }
      return boton;
    }

    // Emparejar: solo tarjetas de respuesta única (§3.7 del plan). Un acierto
    // aquí es refuerzo, no repaso superado — la pista visual (la otra mitad
    // ya en el tablero) hace la mitad del trabajo. No se registra como SRS.
    // Rediseño: dos columnas separadas (preguntas / respuestas), cada una
    // barajada por su cuenta, en vez de una rejilla con todo mezclado.
    function iniciarEmparejar() {
      const disponibles = tarjetasDisponibles(
        tarjetasConTipo,
        relatoConjuntos,
        leerEstado(),
      ).filter((t) => !t.conjunto);

      const numPares = Math.min(6, disponibles.length);
      if (!tablero || numPares < 2) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const elegidas = barajar(disponibles).slice(0, numPares);
      let emparejadas = 0;
      let seleccion: HTMLButtonElement | null = null;
      let bloqueado = false;

      function actualizarProgreso() {
        if (elProgreso) {
          elProgreso.textContent = `${emparejadas} / ${numPares} parejas`;
        }
      }

      function alClic(boton: HTMLButtonElement) {
        if (bloqueado || boton.disabled) return;
        if (!seleccion) {
          seleccion = boton;
          boton.classList.add("elegida");
          return;
        }
        if (seleccion === boton) return;

        if (seleccion.dataset.par === boton.dataset.par) {
          seleccion.classList.remove("elegida");
          seleccion.classList.add("acierto");
          boton.classList.add("acierto");
          seleccion.disabled = true;
          boton.disabled = true;
          seleccion = null;
          emparejadas += 1;
          actualizarProgreso();
          if (emparejadas === numPares) completar("¡Completado!");
        } else {
          bloqueado = true;
          boton.classList.add("fallo");
          seleccion.classList.add("fallo");
          const anterior = seleccion;
          setTimeout(() => {
            anterior.classList.remove("elegida", "fallo");
            boton.classList.remove("fallo");
            bloqueado = false;
          }, 600);
          seleccion = null;
        }
      }

      const columnaPreguntas = crear("div", "columna-emparejar");
      const columnaRespuestas = crear("div", "columna-emparejar");

      for (const t of barajar(elegidas)) {
        const boton = crearPiezaEmparejar(t.pregunta, "pregunta", t.respuesta);
        boton.addEventListener("click", () => alClic(boton));
        columnaPreguntas.appendChild(boton);
      }
      for (const t of barajar(elegidas)) {
        const boton = crearPiezaEmparejar(t.respuesta, "respuesta", t.respuesta, t.tipoRespuesta);
        boton.addEventListener("click", () => alClic(boton));
        columnaRespuestas.appendChild(boton);
      }

      const contenedor = crear("div", "rejilla-emparejar");
      contenedor.append(columnaPreguntas, columnaRespuestas);
      tablero.appendChild(contenedor);
      actualizarProgreso();
    }

    // Ordenar: cinco relatos de una era, desordenados, a colocar. Rediseño:
    // N huecos numerados siempre visibles (vacíos con "—" hasta que se
    // colocan), y el pool de abajo atenúa la pieza colocada en vez de
    // quitarla del todo.
    function iniciarOrdenar() {
      if (!tablero || relatosEra.length < 2) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const secuenciaCorrecta = [...relatosEra].sort((a, b) => a.orden - b.orden);
      let siguiente = 0;

      function actualizarProgreso() {
        if (elProgreso) {
          elProgreso.textContent = `${siguiente} / ${secuenciaCorrecta.length}`;
        }
      }

      const listaSlots = crear("div", "lista-ordenar");
      const filas: { fila: HTMLElement; texto: HTMLElement }[] = [];
      secuenciaCorrecta.forEach((_relato, i) => {
        const fila = crear("div", "fila-slot");
        const badge = crear("span", "badge-slot");
        badge.textContent = String(i + 1);
        const texto = crear("span", "texto-slot");
        texto.textContent = "—";
        fila.append(badge, texto);
        listaSlots.appendChild(fila);
        filas.push({ fila, texto });
      });

      const pool = crear("div", "pool-ordenar");

      for (const relato of barajar(relatosEra)) {
        const boton = crear("button", "pieza-ordenar");
        boton.type = "button";
        boton.textContent = relato.nombre;
        boton.dataset.id = relato.id;
        boton.addEventListener("click", () => {
          if (boton.disabled) return;
          if (relato.id === secuenciaCorrecta[siguiente].id) {
            boton.disabled = true;
            boton.classList.add("colocada");
            const slot = filas[siguiente];
            slot.fila.classList.add("llena");
            slot.texto.textContent = relato.nombre;
            siguiente += 1;
            actualizarProgreso();
            if (siguiente === secuenciaCorrecta.length) completar("¡Completado!");
          } else {
            boton.classList.add("fallo");
            setTimeout(() => boton.classList.remove("fallo"), 500);
          }
        });
        pool.appendChild(boton);
      }

      tablero.append(listaSlots, pool);
      actualizarProgreso();
    }

    // Pertenencia (paso A6): sí/no sobre relaciones de conjunto (padre_de,
    // hermano_de...), donde la opción múltiple no escala con N respuestas
    // correctas. Rediseño: la respuesta correcta queda marcada en verde (se
    // elija o no) y hay que tocar "Siguiente" para avanzar, en vez de
    // autoavanzar tras una pausa.
    function iniciarPertenencia() {
      const disponibles = tarjetasDisponibles(
        pertenencia,
        relatoConjuntos,
        leerEstado(),
      );

      const total = Math.min(10, disponibles.length);
      if (!tablero || total < 4) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const tanda = barajar(disponibles).slice(0, total);
      let indice = 0;
      let aciertos = 0;

      function actualizarProgreso() {
        if (elProgreso) elProgreso.textContent = `${indice} / ${tanda.length}`;
      }

      function mostrarPregunta() {
        if (!tablero) return;
        tablero.innerHTML = "";
        const pregunta = tanda[indice];

        const tarjeta = crear("p", "tarjeta-pertenencia");
        tarjeta.textContent = pregunta.pregunta;
        tablero.appendChild(tarjeta);

        const opciones = crear("div", "opciones-pertenencia");
        tablero.appendChild(opciones);

        for (const [texto, icono, valor] of [
          ["Sí", "✓", true],
          ["No", "✕", false],
        ] as const) {
          const boton = crear("button", "opcion-pertenencia");
          boton.type = "button";
          boton.dataset.valor = String(valor);

          const spanIcono = crear("span", "icono-pertenencia");
          spanIcono.textContent = icono;
          const spanTexto = crear("span");
          spanTexto.textContent = texto;
          boton.append(spanIcono, spanTexto);

          boton.addEventListener("click", () => {
            if (boton.disabled) return;
            const correcta = valor === pregunta.respuesta;
            if (correcta) aciertos += 1;
            for (const otro of opciones.querySelectorAll<HTMLButtonElement>("button")) {
              otro.disabled = true;
              const otroValor = otro.dataset.valor === "true";
              if (otroValor === pregunta.respuesta) otro.classList.add("acierto");
              else if (otro === boton) otro.classList.add("fallo");
            }
            mostrarFeedback(correcta);
          });
          opciones.appendChild(boton);
        }
      }

      function mostrarFeedback(correcta: boolean) {
        if (!tablero) return;
        const feedback = crear("p", correcta ? "feedback acierto" : "feedback fallo");
        feedback.textContent = correcta ? "¡Correcto!" : "No.";
        tablero.appendChild(feedback);

        const siguienteBoton = crear("button", "siguiente-pregunta");
        siguienteBoton.type = "button";
        siguienteBoton.textContent = indice === tanda.length - 1 ? "Ver resultado" : "Siguiente";
        siguienteBoton.addEventListener("click", () => {
          indice += 1;
          actualizarProgreso();
          if (indice < tanda.length) {
            mostrarPregunta();
          } else if (tablero) {
            tablero.innerHTML = "";
            completar(`${aciertos} / ${tanda.length} aciertos.`);
          }
        });
        tablero.appendChild(siguienteBoton);
      }

      actualizarProgreso();
      mostrarPregunta();
    }

    // Completar el árbol: mismo árbol de ego a profundidad 2 que la ficha
    // (/e/[id]/arbol/), con un nodo oculto y opciones para adivinarlo. Los
    // datos (posiciones, enlaces, distractores) ya vienen resueltos desde
    // build (juegoArbol.ts); aquí solo se dibuja y se puntúa. Sin rediseño
    // todavía: conserva su cabecera y su panel de completado propios.
    function iniciarCompletarArbol() {
      const disponibles = tarjetasDisponibles(
        rondasArbol,
        relatoConjuntos,
        leerEstado(),
      );

      const total = Math.min(8, disponibles.length);
      if (!tablero || total < 3) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const tanda = barajar(disponibles).slice(0, total);
      let indice = 0;
      let aciertos = 0;

      function actualizarProgreso() {
        if (elProgreso) elProgreso.textContent = `${indice} / ${tanda.length}`;
      }

      function mostrarRonda() {
        if (!tablero) return;
        tablero.innerHTML = "";
        const ronda = tanda[indice];

        const scroll = document.createElement("div");
        scroll.className = "arbol-juego-scroll";
        const lienzo = document.createElement("div");
        lienzo.className = "arbol-juego-lienzo";
        lienzo.style.width = `${ronda.ancho}px`;
        lienzo.style.height = `${ronda.alto}px`;

        const svgNS = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("class", "arbol-juego-svg");
        svg.setAttribute("width", String(ronda.ancho));
        svg.setAttribute("height", String(ronda.alto));
        svg.setAttribute("viewBox", `0 0 ${ronda.ancho} ${ronda.alto}`);

        const posiciones = new Map(ronda.nodos.map((n) => [n.clave, n]));
        for (const enlace of ronda.enlaces) {
          const desde = posiciones.get(enlace.desde);
          const hasta = posiciones.get(enlace.hasta);
          if (!desde || !hasta) continue;
          const linea = document.createElementNS(svgNS, "line");
          linea.setAttribute("x1", String(desde.x));
          linea.setAttribute("y1", String(desde.y));
          linea.setAttribute("x2", String(hasta.x));
          linea.setAttribute("y2", String(hasta.y));
          svg.appendChild(linea);
        }
        lienzo.appendChild(svg);

        let cajaHueco: HTMLElement | null = null;
        for (const nodo of ronda.nodos) {
          const caja = document.createElement("div");
          caja.className = "arbol-juego-nodo";
          caja.style.left = `${nodo.x}px`;
          caja.style.top = `${nodo.y}px`;
          if (nodo.esHueco) {
            caja.classList.add("hueco");
            caja.textContent = "?";
            cajaHueco = caja;
          } else {
            caja.textContent = nodo.nombre;
          }
          lienzo.appendChild(caja);
        }
        scroll.appendChild(lienzo);
        tablero.appendChild(scroll);

        const opciones = document.createElement("div");
        opciones.className = "opciones-arbol";
        for (const opcion of ronda.opciones) {
          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "opcion-arbol";
          boton.textContent = opcion.nombre;
          boton.addEventListener("click", () => {
            for (const otro of opciones.querySelectorAll("button")) {
              (otro as HTMLButtonElement).disabled = true;
            }
            const correcta = opcion.id === ronda.correctaId;
            boton.classList.add(correcta ? "acierto" : "fallo");
            if (cajaHueco) {
              cajaHueco.textContent = ronda.opciones.find(
                (o) => o.id === ronda.correctaId,
              )?.nombre ?? "?";
              cajaHueco.classList.remove("hueco");
              cajaHueco.classList.add(correcta ? "acierto" : "fallo");
            }
            if (correcta) aciertos += 1;
            setTimeout(() => {
              indice += 1;
              actualizarProgreso();
              if (indice < tanda.length) {
                mostrarRonda();
              } else if (tablero) {
                tablero.innerHTML = "";
                completar(`¡Completado! ${aciertos} / ${tanda.length} aciertos.`);
              }
            }, 900);
          });
          opciones.appendChild(boton);
        }
        tablero.appendChild(opciones);
      }

      actualizarProgreso();
      mostrarRonda();
    }

    // Identificar (plan de imágenes y álbum, reservado en materia.yaml junto a
    // `representa`/`representado_en`): sale la imagen de una obra y hay que
    // elegir a quién o qué representa entre hasta cuatro opciones. Mismo
    // patrón de feedback + "Siguiente" que pertenencia.
    function iniciarIdentificar() {
      const disponibles = tarjetasDisponibles(
        rondasIdentificar,
        relatoConjuntos,
        leerEstado(),
      );

      const total = Math.min(10, disponibles.length);
      if (!tablero || total < 3) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const tanda = barajar(disponibles).slice(0, total);
      let indice = 0;
      let aciertos = 0;

      function actualizarProgreso() {
        if (elProgreso) elProgreso.textContent = `${indice} / ${tanda.length}`;
      }

      function mostrarRonda() {
        if (!tablero) return;
        tablero.innerHTML = "";
        const ronda = tanda[indice];

        // `crear`, no `document.createElement`: un <img> creado a pelo no
        // lleva la marca data-astro-cid-* (ver el comentario de ATRIBUTO_CID
        // más arriba) y el CSS con scope de abajo no le aplica nada — el
        // primer intento de esta pantalla se quedó sin `object-fit: cover`
        // por este motivo exacto, y el resultado era una imagen estirada
        // (sin recortar) dentro de la caja del `aspect-ratio`.
        const figura = crear("figure", "figura-identificar");
        const img = crear("img");
        img.src = rutaActivo(ronda.imagen.archivo);
        img.alt = ronda.imagen.alt ?? "";
        // Con `recorte`: recorte fiel de una figura dentro de un cuadro de
        // grupo (`object-fit: cover`, nunca estira). Sin `recorte`: la obra
        // entera a su proporción real, escalada por `width: 100%; height:
        // auto` sin recortar ni deformar (regla por defecto en el CSS).
        if (ronda.foco && ronda.recorte) {
          figura.classList.add("figura-identificar--recorte");
          const ratio = calcularAspectRatio(ronda.imagen, ronda.recorte);
          const estilos = [`object-position: ${ronda.foco[0]}% ${ronda.foco[1]}%`];
          if (ratio) estilos.push(`aspect-ratio: ${ratio}`);
          img.style.cssText = estilos.join("; ");
        }
        figura.appendChild(img);
        tablero.appendChild(figura);

        const pregunta = crear("p", "pregunta-identificar");
        pregunta.textContent = "¿Quién o qué es?";
        tablero.appendChild(pregunta);

        const opciones = crear("div", "opciones-identificar");
        tablero.appendChild(opciones);

        for (const opcion of ronda.opciones) {
          const boton = crear("button", "opcion-identificar");
          boton.type = "button";
          boton.textContent = opcion.nombre;
          boton.addEventListener("click", () => {
            const correcta = opcion.id === ronda.correctaId;
            if (correcta) aciertos += 1;
            for (const otro of opciones.querySelectorAll<HTMLButtonElement>("button")) {
              otro.disabled = true;
              if (otro.textContent === ronda.opciones.find((o) => o.id === ronda.correctaId)?.nombre) {
                otro.classList.add("acierto");
              } else if (otro === boton) {
                otro.classList.add("fallo");
              }
            }
            mostrarFeedback(correcta);
          });
          opciones.appendChild(boton);
        }
      }

      function mostrarFeedback(correcta: boolean) {
        if (!tablero) return;
        const feedback = crear("p", correcta ? "feedback acierto" : "feedback fallo");
        feedback.textContent = correcta ? "¡Correcto!" : "No.";
        tablero.appendChild(feedback);

        const siguienteBoton = crear("button", "siguiente-pregunta");
        siguienteBoton.type = "button";
        siguienteBoton.textContent = indice === tanda.length - 1 ? "Ver resultado" : "Siguiente";
        siguienteBoton.addEventListener("click", () => {
          indice += 1;
          actualizarProgreso();
          if (indice < tanda.length) {
            mostrarRonda();
          } else if (tablero) {
            tablero.innerHTML = "";
            completar(`${aciertos} / ${tanda.length} aciertos.`);
          }
        });
        tablero.appendChild(siguienteBoton);
      }

      actualizarProgreso();
      mostrarRonda();
    }

    const juego = tablero?.dataset.juego;

    function iniciar() {
      if (!tablero) return;
      tablero.innerHTML = "";
      elPanelCompletado?.setAttribute("hidden", "");
      elSinTarjetas?.setAttribute("hidden", "");
      if (juego === "emparejar") iniciarEmparejar();
      if (juego === "ordenar") iniciarOrdenar();
      if (juego === "pertenencia") iniciarPertenencia();
      if (juego === "completar-arbol") iniciarCompletarArbol();
      if (juego === "identificar") iniciarIdentificar();
    }

    // "Reiniciar"/"Jugar de nuevo" solo existen en emparejar/ordenar/
    // pertenencia (completar-arbol conserva Salir/Volver a Practicar).
    document.getElementById("reiniciar")?.addEventListener("click", iniciar);
    document.getElementById("jugar-de-nuevo")?.addEventListener("click", iniciar);

    iniciar();
  </script>

