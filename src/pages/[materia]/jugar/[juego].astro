      animation: agitar-fallo 0.3s ease;
    }

    /* Identificar: imagen grande arriba, pregunta corta, rejilla de hasta
       cuatro opciones. La obra se ve siempre entera, a su proporción real
       (width 100%, height auto: nunca se recorta ni se deforma) — el
       contexto completo es parte de lo que ayuda a identificar. `foco` y
       `recorte` dibujan un marco encima señalando a qué figura se refiere
       la pregunta, en vez de recortar la imagen a esa figura. */
    .figura-identificar {
      position: relative;
      overflow: hidden;
      margin: 0 0 16px;
      line-height: 0;
    }

    .figura-identificar img {
      display: block;
      width: 100%;
      height: auto;
    }

    .marco-identificar {
      position: absolute;
      border: 3px solid var(--color-acento);
      border-radius: 4px;
      box-shadow: 0 0 0 999px rgb(0 0 0 / 45%);
      pointer-events: none;
    }

    .marca-identificar {
      position: absolute;
      width: 18px;
      height: 18px;
      transform: translate(-50%, -50%);
      border: 3px solid var(--color-acento);
      border-radius: 50%;
      background: color-mix(in srgb, var(--color-acento) 30%, transparent);
      pointer-events: none;
    }

    .pregunta-identificar {
      margin: 0 20px 14px;
      font-family: var(--fuente-titulo);
      font-size: 18px;
      font-weight: 700;
    }

    .opciones-identificar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 0 20px;
    }

    .opcion-identificar {
      padding: 14px 10px;
      border: 1.5px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-fondo-pantalla);
      color: var(--color-texto);
      font-family: var(--fuente-titulo);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
      cursor: pointer;
    }

    .opcion-identificar.acierto {
      border-color: var(--color-acierto);
      background: color-mix(in srgb, var(--color-acierto) 12%, var(--color-fondo-pantalla));
      animation: destello-acierto 0.3s ease;
    }

    .opcion-identificar.fallo {
      border-color: var(--color-fallo);
      animation: agitar-fallo 0.3s ease;
    }

    .opcion-identificar:disabled {
      cursor: default;
    }

    @keyframes destello-acierto {
      0% {
        transform: scale(1);
      }
      40% {
        transform: scale(1.05);
      }
      100% {
        transform: scale(1);
      }
    }

    @keyframes agitar-fallo {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-4px);
      }
      75% {
        transform: translateX(4px);
      }
    }
  </style>
</Base>
