---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { conjuntoDeRelato } from "../../../lib/desbloqueo";
import { rutaMateria } from "../../../lib/rutas";
import { generarTarjetas } from "../../../lib/tarjetas";

export async function getStaticPaths() {
	const materias = await getCollection("materias");
	const juegos = ["emparejar", "ordenar"];
	return materias.flatMap((m) =>
		juegos.map((juego) => ({
			params: { materia: m.data.slug, juego },
			props: { materiaId: m.id },
		})),
	);
}

const { materia, juego } = Astro.params;
const { materiaId } = Astro.props;

const tarjetas = await generarTarjetas(materiaId);
const relatos = await getCollection("relatos");
const relatoConjuntos = Object.fromEntries(
	relatos.map((r) => [r.id, conjuntoDeRelato(r.data)]),
);

// Ordenar (paso 8): la era con más relatos, en su `orden` real. Los datos ya
// existen (`era` + `orden`); no hace falta tocar el esquema.
const materiaEntry = await getEntry("materias", materiaId);
const eras = materiaEntry?.data.eras ?? [];
const porEra = new Map<
	string,
	{ id: string; nombre: string; orden: number }[]
>();
for (const r of relatos) {
	if (!r.data.era || r.data.orden === undefined) continue;
	const lista = porEra.get(r.data.era) ?? [];
	lista.push({ id: r.id, nombre: r.data.nombre, orden: r.data.orden });
	porEra.set(r.data.era, lista);
}
let relatosEra: { id: string; nombre: string; orden: number }[] = [];
let nombreEraOrdenar = "";
for (const era of eras) {
	const lista = porEra.get(era.id);
	if (lista && lista.length > relatosEra.length) {
		relatosEra = lista;
		nombreEraOrdenar = era.nombre;
	}
}
relatosEra.sort((a, b) => a.orden - b.orden);

const TITULOS: Record<string, string> = {
	emparejar: "Emparejar",
	ordenar: "Ordenar",
};
const titulo = TITULOS[juego ?? ""] ?? juego;
---

<Base titulo={`${titulo} — ${materia}`}>
  <article class="juego">
    <header class="cabecera-juego">
      <div>
        <h1>{titulo}</h1>
        {juego === "ordenar" && nombreEraOrdenar && <p class="subtitulo">{nombreEraOrdenar}</p>}
      </div>
      <p id="progreso"></p>
    </header>

    <div id="tablero" data-juego={juego}></div>

    <p id="mensaje" hidden></p>
    <p id="sin-tarjetas" hidden>
      Todavía no hay tarjetas suficientes para jugar. Lee algún relato más, o
      cambia a modo sandbox.
    </p>

    <p class="salir"><a href={rutaMateria(materia)}>&larr; Salir</a></p>
  </article>

  <script
    is:inline
    type="application/json"
    id="datos-juego"
    set:html={JSON.stringify({ tarjetas, relatoConjuntos, relatosEra })}
  />

  <script>
    import { tarjetasDisponibles } from "../../../lib/disponibilidad";
    import { leerEstado } from "../../../lib/estado";
    import type { Tarjeta } from "../../../lib/tarjetas";

    interface RelatoEra {
      id: string;
      nombre: string;
      orden: number;
    }

    const datosEl = document.getElementById("datos-juego");
    const { tarjetas, relatoConjuntos, relatosEra } = datosEl
      ? (JSON.parse(datosEl.textContent ?? "{}") as {
          tarjetas: Tarjeta[];
          relatoConjuntos: Record<string, string[]>;
          relatosEra: RelatoEra[];
        })
      : {
          tarjetas: [] as Tarjeta[],
          relatoConjuntos: {},
          relatosEra: [] as RelatoEra[],
        };

    const tablero = document.getElementById("tablero");
    const elProgreso = document.getElementById("progreso");
    const elMensaje = document.getElementById("mensaje");
    const elSinTarjetas = document.getElementById("sin-tarjetas");

    function barajar<T>(arr: T[]): T[] {
      const copia = [...arr];
      for (let i = copia.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copia[i], copia[j]] = [copia[j], copia[i]];
      }
      return copia;
    }

    // Emparejar: solo tarjetas de respuesta única (§3.7 del plan). Un acierto
    // aquí es refuerzo, no repaso superado — la pista visual (la otra mitad
    // ya en el tablero) hace la mitad del trabajo. No se registra como SRS.
    function iniciarEmparejar() {
      const disponibles = tarjetasDisponibles(
        tarjetas,
        relatoConjuntos,
        leerEstado(),
      ).filter((t) => !t.conjunto);

      const numPares = Math.min(6, disponibles.length);
      if (!tablero || numPares < 2) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const elegidas = barajar(disponibles).slice(0, numPares);
      let emparejadas = 0;
      let seleccion: HTMLButtonElement | null = null;
      let bloqueado = false;

      function actualizarProgreso() {
        if (elProgreso) {
          elProgreso.textContent = `${emparejadas} / ${numPares} parejas`;
        }
      }

      const piezas = elegidas.flatMap((t, i) => [
        { par: i, texto: t.pregunta, tipo: "pregunta" as const },
        { par: i, texto: t.respuesta, tipo: "respuesta" as const },
      ]);

      const contenedor = document.createElement("div");
      contenedor.className = "rejilla-emparejar";
      for (const pieza of barajar(piezas)) {
        const boton = document.createElement("button");
        boton.type = "button";
        boton.className = "pieza";
        boton.textContent = pieza.texto;
        boton.dataset.par = String(pieza.par);
        boton.addEventListener("click", () => {
          if (bloqueado || boton.disabled) return;
          if (!seleccion) {
            seleccion = boton;
            boton.classList.add("elegida");
            return;
          }
          if (seleccion === boton) return;

          if (seleccion.dataset.par === boton.dataset.par) {
            seleccion.classList.remove("elegida");
            seleccion.classList.add("acierto");
            boton.classList.add("acierto");
            seleccion.disabled = true;
            boton.disabled = true;
            seleccion = null;
            emparejadas += 1;
            actualizarProgreso();
            if (emparejadas === numPares && elMensaje) {
              elMensaje.hidden = false;
              elMensaje.textContent = "¡Completado!";
            }
          } else {
            bloqueado = true;
            boton.classList.add("fallo");
            seleccion.classList.add("fallo");
            const anterior = seleccion;
            setTimeout(() => {
              anterior.classList.remove("elegida", "fallo");
              boton.classList.remove("fallo");
              bloqueado = false;
            }, 600);
            seleccion = null;
          }
        });
        contenedor.appendChild(boton);
      }

      tablero.appendChild(contenedor);
      actualizarProgreso();
    }

    // Ordenar: cinco relatos de una era, desordenados, a colocar. Los datos ya
    // existen (`era` + `orden`); el juego solo consume el orden real.
    function iniciarOrdenar() {
      if (!tablero || relatosEra.length < 2) {
        elSinTarjetas?.removeAttribute("hidden");
        return;
      }

      const secuenciaCorrecta = [...relatosEra].sort((a, b) => a.orden - b.orden);
      let siguiente = 0;

      function actualizarProgreso() {
        if (elProgreso) {
          elProgreso.textContent = `${siguiente} / ${secuenciaCorrecta.length}`;
        }
      }

      const lista = document.createElement("ol");
      lista.className = "lista-ordenar";

      const pool = document.createElement("div");
      pool.className = "pool-ordenar";

      for (const relato of barajar(relatosEra)) {
        const boton = document.createElement("button");
        boton.type = "button";
        boton.className = "pieza-ordenar";
        boton.textContent = relato.nombre;
        boton.dataset.id = relato.id;
        boton.addEventListener("click", () => {
          if (boton.disabled) return;
          if (relato.id === secuenciaCorrecta[siguiente].id) {
            boton.disabled = true;
            boton.classList.add("acierto");
            const item = document.createElement("li");
            item.textContent = relato.nombre;
            lista.appendChild(item);
            siguiente += 1;
            actualizarProgreso();
            if (siguiente === secuenciaCorrecta.length && elMensaje) {
              elMensaje.hidden = false;
              elMensaje.textContent = "¡Completado!";
            }
          } else {
            boton.classList.add("fallo");
            setTimeout(() => boton.classList.remove("fallo"), 500);
          }
        });
        pool.appendChild(boton);
      }

      tablero.appendChild(lista);
      tablero.appendChild(pool);
      actualizarProgreso();
    }

    const juego = tablero?.dataset.juego;
    if (juego === "emparejar") iniciarEmparejar();
    if (juego === "ordenar") iniciarOrdenar();
  </script>

  <style>
    .cabecera-juego {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 12px 20px;
    }

    .rejilla-emparejar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      padding: 0 20px;
    }

    .pieza {
      min-height: 64px;
      padding: 10px;
      border: 1px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente);
      font-size: 14px;
      cursor: pointer;
    }

    .pieza.elegida {
      border-color: var(--color-acento);
    }

    .pieza.acierto {
      opacity: 0.4;
      cursor: default;
    }

    .pieza.fallo {
      border-color: crimson;
    }

    .subtitulo {
      margin: 2px 0 0;
      font-size: 13px;
      color: var(--color-texto-muted);
    }

    .lista-ordenar {
      margin: 0 20px 12px;
      padding-left: 20px;
    }

    .pool-ordenar {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 0 20px;
    }

    .pieza-ordenar {
      padding: 14px;
      border: 1px solid var(--color-tarjeta-borde);
      border-radius: var(--radio);
      background: var(--color-tarjeta-fondo);
      color: var(--color-texto);
      font-family: var(--fuente);
      font-size: 15px;
      text-align: left;
      cursor: pointer;
    }

    .pieza-ordenar.acierto {
      display: none;
    }

    .pieza-ordenar.fallo {
      border-color: crimson;
    }

    .salir {
      padding: 20px;
    }
  </style>
</Base>
